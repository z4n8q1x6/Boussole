<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>tn.esprit</groupId>
    <artifactId>Boussole</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Upgraded JavaFX patch version to address transitive CVE reports and improve security
             Minimal non-breaking change: 17.0.2 → 17.0.8 -->
        <javafx.version>17.0.8</javafx.version>
        <!-- Plateforme JavaFX (classifier) - changez en mac, linux, win selon l'OS d'exécution -->
        <javafx.platform>win</javafx.platform>
    </properties>

    <dependencies>

        <!-- NOTE: CVE-2023-22102 (HIGH) affects mysql-connector-java@8.0.33.
             At the time of analysis no patched version was available according to the CVE database.
             This project keeps the current connector version to avoid downgrades or untested changes.
             Recommended mitigations until a patched connector is released:
               - Restrict network access to the database (firewall, private network)
               - Use TLS/SSL for DB connections and require authentication
               - Keep an eye on Oracle/MySQL advisories and upgrade connector when a patched release appears
        -->

        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>

        <!-- JavaFX Controls (Boutons, Labels...) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>

        <!-- JavaFX FXML (Pour lire tes fichiers .fxml) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>

        <!-- iText 5 : Librairie pour générer des PDF -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13.3</version>
        </dependency>

        <!-- Dependency for JSON parsing -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20231013</version>
        </dependency>

        <!-- Apache Commons Math for K-Means Clustering (AI) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
            <version>3.6.1</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>tn.esprit.Boussole.App</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>