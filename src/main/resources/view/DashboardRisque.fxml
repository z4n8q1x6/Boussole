<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" style="-fx-background-color: #1e2b3c;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardRisqueController">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="30.0" layoutY="20.0" spacing="25.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0">
         <children>
            <Label text="Tableau de Bord des Risques - BOUSSOLE" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Label>

            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <VBox prefWidth="185.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 0);">
                     <children>
                        <Label text="CAPITAL PRÊTÉ" textFill="#7f8c8d">
                           <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <Label fx:id="lblTotalPrete" text="0.00 DT" textFill="#2980b9">
                           <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox prefWidth="185.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 0);">
                     <children>
                        <Label text="TOTAL RÉCUPÉRÉ" textFill="#7f8c8d">
                           <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <Label fx:id="lblTotalRembourse" text="0.00 DT" textFill="#27ae60">
                           <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox prefWidth="185.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 0);">
                     <children>
                        <Label text="RESTE À RECOUVRER" textFill="#7f8c8d">
                           <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <Label fx:id="lblTotalRestant" text="0.00 DT" textFill="#e67e22">
                           <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox prefWidth="185.0" spacing="5.0" style="-fx-background-color: #fff5f5; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #e74c3c; -fx-border-radius: 10; -fx-border-width: 2; -fx-effect: dropshadow(three-pass-box, rgba(231, 76, 60, 0.3), 10, 0, 0, 0);">
                     <children>
                        <Label text="⚠️ RISQUE D'IMPAYÉS" textFill="#e74c3c">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblTotalImpayes" text="0.00 DT" textFill="#c0392b">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <Label text="Mensualités dépassées" textFill="#7f8c8d" style="-fx-font-size: 9;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.9); -fx-padding: 10; -fx-background-radius: 15;">
               <children>
                  <PieChart fx:id="chartStatuts" legendSide="RIGHT" prefHeight="350.0" title="Répartition du Portefeuille Prêts" />
               </children>
            </VBox>

            <Button mnemonicParsing="false" onAction="#retourListe" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="← Retour à la gestion des prêts">
               <font><Font name="System Bold" size="13.0" /></font>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>