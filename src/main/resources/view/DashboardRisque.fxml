<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1000.0" styleClass="main-container" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardRisqueController">
   <children>
      <VBox layoutX="30.0" layoutY="30.0" spacing="30.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
         <children>
            <Label styleClass="app-title" text="Tableau de Bord des Risques - BOUSSOLE" />

            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <VBox prefWidth="220.0" styleClass="form-card">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="CAPITAL PRÊTÉ" textFill="#94A3B8" />
                        <Label fx:id="lblTotalPrete" style="-fx-font-size: 24; -fx-font-weight: 900;" text="0.00 DT" textFill="#00E5CC" />
                     </children>
                  </VBox>

                  <VBox prefWidth="220.0" styleClass="form-card">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="TOTAL RÉCUPÉRÉ" textFill="#94A3B8" />
                        <Label fx:id="lblTotalRembourse" style="-fx-font-size: 24; -fx-font-weight: 900;" text="0.00 DT" textFill="#10B981" />
                     </children>
                  </VBox>

                  <VBox prefWidth="220.0" styleClass="form-card">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="RESTE À RECOUVRER" textFill="#94A3B8" />
                        <Label fx:id="lblTotalRestant" style="-fx-font-size: 24; -fx-font-weight: 900;" text="0.00 DT" textFill="#E67E22" />
                     </children>
                  </VBox>

                  <VBox prefWidth="220.0" styleClass="form-card" style="-fx-border-color: rgba(248, 113, 113, 0.3); -fx-border-width: 1;">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="⚠️ RISQUE D'IMPAYÉS" textFill="#F87171" />
                        <Label fx:id="lblTotalImpayes" style="-fx-font-size: 24; -fx-font-weight: 900;" text="0.00 DT" textFill="#EF4444" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox alignment="CENTER" minHeight="350" styleClass="form-card" VBox.vgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-padding: 0 0 15 0; -fx-font-size: 16;" text="Répartition du Portefeuille Prêts" textFill="WHITE" />
                  <PieChart fx:id="chartStatuts" legendSide="RIGHT" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>

            <HBox alignment="CENTER_LEFT">
               <children>
                  <Button mnemonicParsing="false" onAction="#retourListe" prefHeight="45.0" prefWidth="280.0" styleClass="sidebar-button" style="-fx-background-color: rgba(255,255,255,0.05); -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10;" text="← Retour à la gestion des prêts">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>