<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.ListePretsController">
    <VBox spacing="20" styleClass="sidebar" prefWidth="200" alignment="TOP_CENTER">
        <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@boussole.png" />
        </ImageView>
        <Label text="BOUSSOLE" styleClass="sidebar-title"/>
        <Separator opacity="0.3"/>
        <Button text="➕ Nouvelle Demande" onAction="#ouvrirFormulaire" styleClass="sidebar-button" maxWidth="Infinity"/>
        <Button text="📋 Liste des Prêts" styleClass="sidebar-button-active" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="20" alignment="TOP_CENTER" styleClass="main-container" HBox.hgrow="ALWAYS" fx:id="mainContent">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <Label text="Gestion des Prêts - Comité" styleClass="app-title"/>

        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="form-card">
            <TextField fx:id="txtRecherche" promptText="Rechercher par ID ou Motif..." prefWidth="300" styleClass="custom-field"/>

            <ComboBox fx:id="comboStatut" prefWidth="150" styleClass="custom-field"/>

            <Button text="Rafraîchir" onAction="#chargerDonnees" styleClass="login-button"/>
        </HBox>

        <TableView fx:id="tablePrets" VBox.vgrow="ALWAYS" styleClass="form-card">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                <TableColumn fx:id="colMotif" text="Motif" prefWidth="200" />
                <TableColumn fx:id="colMontant" text="Montant" prefWidth="120" />
                <TableColumn fx:id="colDuree" text="Mois" prefWidth="80" />
                <TableColumn fx:id="colTaux" text="Taux %" prefWidth="50" />
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="100" />
                <TableColumn fx:id="colActions" text="Actions" prefWidth="110" />
            </columns>
        </TableView>
    </VBox>
</HBox>