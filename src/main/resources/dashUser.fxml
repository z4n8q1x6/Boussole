<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1400.0" style="-fx-background-color: #0B0F1A;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.dashUserController">
    <children>
        <!-- ===================== SIDEBAR ===================== -->
        <VBox prefWidth="260" style="-fx-background-color: linear-gradient(to bottom, #0F172A, #020617);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- En-tête du menu -->
                <VBox alignment="CENTER" prefHeight="120.0" spacing="10.0">
                    <children>
                        <Label text="🧭" textFill="WHITE">
                            <font>
                                <Font size="30.0" />
                            </font>
                        </Label>
                        <Label text="Boussole" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label text="PANEL ENTREPRISE" textFill="#64748B" style="-fx-font-weight: bold;"/>
                    </children>
                </VBox>

                <!-- Boutons du menu -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="10.0" style="-fx-background-color: transparent;">
                            <padding>
                                <Insets left="20.0" right="20.0" />
                            </padding>
                            <children>
                                <Label text="PRINCIPAL" textFill="#64748B" style="-fx-font-weight: bold;">
                                    <padding>
                                        <Insets bottom="5.0" left="10.0" />
                                    </padding>
                                </Label>
                                <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="📊  Tableau de bord" />
                                <Button fx:id="btnProduit" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="📦  Produit" />
                                <Button fx:id="btnCommande" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="🛒  Commande" />
                                <Button fx:id="btnLigneCommande" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="📝  Ligne commande" />

                                <Label text="📌 GESTION" textFill="#64748B" style="-fx-font-weight: bold;">
                                    <padding>
                                        <Insets bottom="5.0" left="10.0" top="15.0" />
                                    </padding>
                                </Label>
                                <Button fx:id="btnFournisseur" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="🚚  Fournisseur" />
                                <Button fx:id="btnFranchises" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="🏢  Franchises" />
                                <Button fx:id="btnAlertes" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="⚠️  Alertes" />
                                <Button fx:id="btnReclamations" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="📢  Réclamations" />

                                <Label text="📌 FINANCES" textFill="#64748B" style="-fx-font-weight: bold;">
                                    <padding>
                                        <Insets bottom="5.0" left="10.0" top="15.0" />
                                    </padding>
                                </Label>
                                <Button fx:id="btnBilan" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="📈  Bilan" />
                                <Button fx:id="btnBudget" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="💰  Budget prévisionnel" />
                                <Button fx:id="btnCharge" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="💸  Charge" />
                                <Button fx:id="btnMensualite" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="📅  Mensualité" />
                                <Button fx:id="btnPret" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="🏦  Prêt" />
                                <Button fx:id="btnTransaction" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="💳  Transaction" />
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- Bouton déconnexion -->
                <Button fx:id="btnLogout" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="50.0" prefWidth="260.0" style="-fx-background-color: transparent; -fx-text-fill: #EF4444; -fx-font-weight: bold;" text="🚪  Déconnexion">
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                </Button>
            </children>
        </VBox>

        <!-- ===================== MAIN CONTENT ===================== -->
        <VBox layoutX="260.0" spacing="25.0" style="-fx-background-color: #0B0F1A;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="260.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label fx:id="lblPageTitle" text="Tableau de bord" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill:white;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label style="-fx-background-color: #0EA5E9; -fx-background-radius: 20; -fx-text-fill: white; -fx-padding: 10;" text="U">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblUsername" text="Utilisateur" textFill="#94A3B8">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Zone de contenu dynamique -->
                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </children>

    <stylesheets>
        <URL value="@/styles/dash.css" />
    </stylesheets>
</AnchorPane>
