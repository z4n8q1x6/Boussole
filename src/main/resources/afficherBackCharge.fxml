<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="950.0" spacing="25.0" style="-fx-background-color: #06080F;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.chargesdepenses.gui.afficherBackChargeController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Gestion des Charges" textFill="#E8EDF5">
                <font><Font name="System Bold" size="26.0" /></font>
            </Label>
            <Label text="Visualisation et gestion des dépenses enregistrées" textFill="#8892A4">
                <font><Font size="13.0" /></font>
            </Label>
        </VBox>
        <HBox spacing="10">
            <Button fx:id="btnFront" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-cursor: hand;" text="Vue Front" />
            <Button fx:id="btnAjouter" style="-fx-background-color: #0EA5E9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20; -fx-cursor: hand;" text="+ Ajouter" />
        </HBox>
    </HBox>

    <HBox spacing="15.0">
        <TextField fx:id="txtRecherche" prefHeight="42.0" prefWidth="380.0" promptText="🔍 Rechercher une charge (titre...)" style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 15 0 15;" />
        <ComboBox fx:id="comboTri" prefHeight="42.0" promptText="Trier par" style="-fx-background-color: #0C0F1A; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10; -fx-background-radius: 10;" />
    </HBox>

    <TableView fx:id="tableCharges" styleClass="dark-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitre" prefWidth="130.0" text="TITRE" />
            <TableColumn fx:id="colMontant" prefWidth="92.00003051757812" text="MONTANT" />
            <TableColumn fx:id="colDate" prefWidth="127.19996643066406" text="DATE" />
            <TableColumn fx:id="colType" prefWidth="160.80001831054688" text="TYPE" />
            <TableColumn fx:id="colStatus" prefWidth="100.0" text="STATUT" />
            <TableColumn fx:id="colFranchiseId" prefWidth="130.0" text="NOM FRANCHISE" />
            <TableColumn fx:id="colModifier" prefWidth="60.0" text="MOD" />
            <TableColumn fx:id="colSupprimer" prefWidth="60.0" text="SUPP" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="lblTotal" text="Total : 0.0 DT" textFill="#E8EDF5">
            <font><Font name="System Bold" size="16.0" /></font>
        </Label>
    </HBox>
</VBox>
