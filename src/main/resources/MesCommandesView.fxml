<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #06080F;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.franchise.MesCommandesController">
    <padding><Insets bottom="25" left="25" right="25" top="25"/></padding>

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="📦" style="-fx-font-size: 28px;" />
        <Label style="-fx-text-fill: #E8EDF5; -fx-font-size: 26px; -fx-font-weight: bold;" text="Mes commandes" />
    </HBox>

    <!-- Statistiques -->
    <HBox spacing="15">
        <VBox style="-fx-background-color: #0F1523; -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.05); -fx-border-radius: 15; -fx-padding: 20;">
            <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;" text="TOTAL COMMANDES" />
            <Label fx:id="totalCommandesLabel" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="0" />
        </VBox>
        <VBox style="-fx-background-color: #0F1523; -fx-background-radius: 15; -fx-border-color: #00E5CC; -fx-border-radius: 15; -fx-padding: 20;">
            <Label style="-fx-text-fill: #00E5CC; -fx-font-size: 11px; -fx-font-weight: bold;" text="TOTAL DÉPENSÉ" />
            <Label fx:id="totalDepenseLabel" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="0 DT" />
        </VBox>
    </HBox>

    <!-- Filtres -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Filtrer par statut:" style="-fx-text-fill: #8892A4;"/>
        <ComboBox fx:id="filtreStatutCombo" prefWidth="200" prefHeight="38"
                  style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10; -fx-background-radius: 10;"/>
        <Button onAction="#handleRefresh"
                style="-fx-background-color: #0C0F1A; -fx-text-fill: #00E5CC; -fx-font-weight: bold; -fx-border-color: #00E5CC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;"
                text="Rafraîchir" prefHeight="38"/>
    </HBox>

    <!-- Tableau des commandes -->
    <TableView fx:id="commandeTable" VBox.vgrow="ALWAYS" prefHeight="400"
               style="-fx-background-color: transparent; -fx-control-inner-background: #0C0F1A; -fx-border-color: rgba(255,255,255,0.06); -fx-border-radius: 12; -fx-background-radius: 12;">
        <columns>
            <TableColumn fx:id="colDate" prefWidth="200" text="DATE" />
            <TableColumn fx:id="colTotal" prefWidth="150" text="TOTAL" />
            <TableColumn fx:id="colStatut" prefWidth="150" text="STATUT" />
            <TableColumn fx:id="colActions" prefWidth="150" text="ACTIONS" />
        </columns>
    </TableView>

    <!-- Boutons de filtre rapide -->
    <HBox spacing="15" alignment="CENTER">
        <Button onAction="#handleEnAttente"
                style="-fx-background-color: rgba(245,158,11,0.15); -fx-text-fill: #F59E0B; -fx-font-weight: bold; -fx-border-color: rgba(245,158,11,0.3); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;"
                text="⏳ En attente" prefHeight="38" prefWidth="120"/>
        <Button onAction="#handleValidees"
                style="-fx-background-color: rgba(16,185,129,0.15); -fx-text-fill: #10B981; -fx-font-weight: bold; -fx-border-color: rgba(16,185,129,0.3); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;"
                text="✅ Validées" prefHeight="38" prefWidth="120"/>
        <Button onAction="#handleRefusees"
                style="-fx-background-color: rgba(239,68,68,0.15); -fx-text-fill: #EF4444; -fx-font-weight: bold; -fx-border-color: rgba(239,68,68,0.3); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;"
                text="❌ Refusées" prefHeight="38" prefWidth="120"/>
        <Button onAction="#handleVoirToutes"
                style="-fx-background-color: #0C0F1A; -fx-text-fill: #00E5CC; -fx-font-weight: bold; -fx-border-color: #00E5CC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;"
                text="📋 Toutes" prefHeight="38" prefWidth="120"/>
    </HBox>
</VBox>