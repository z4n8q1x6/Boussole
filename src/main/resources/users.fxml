<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="950.0" spacing="25.0"
      style="-fx-background-color: #06080F;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.boussole.gui.usersController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Gestion des Utilisateurs" textFill="#E8EDF5">
                <font><Font name="System Bold" size="26.0" /></font>
            </Label>
            <Label text="Administration des comptes et permissions" textFill="#8892A4">
                <font><Font size="13.0" /></font>
            </Label>
        </VBox>

        <Button fx:id="btnNewUser" onAction="#handleNewUser" prefHeight="42.0"
                style="-fx-background-color: #00E5CC; -fx-text-fill: #06080F; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"
                text="+ Ajouter un membre">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
        </Button>
    </HBox>

    <!-- STATISTIQUES CARDS -->
    <HBox spacing="20.0">
        <!-- Card 1: Total Users -->
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #0F1523; -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.05); -fx-border-radius: 15; -fx-padding: 20;">
            <children>
                <Label text="TOTAL UTILISATEURS" textFill="#64748B">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="lblTotalUsers" text="0" textFill="WHITE">
                        <font><Font name="System Bold" size="28.0" /></font>
                    </Label>
                    <Label text="👥" textFill="#3B82F6" style="-fx-font-size: 20px;"/>
                </HBox>
            </children>
        </VBox>

        <!-- Card 2: Active Users -->
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #0F1523; -fx-background-radius: 15; -fx-border-color: rgba(16, 185, 129, 0.2); -fx-border-radius: 15; -fx-padding: 20;">
            <children>
                <Label text="COMPTES ACTIFS" textFill="#10B981">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="lblActiveUsers" text="0" textFill="WHITE">
                        <font><Font name="System Bold" size="28.0" /></font>
                    </Label>
                    <Label text="✅" textFill="#10B981" style="-fx-font-size: 20px;"/>
                </HBox>
            </children>
        </VBox>

        <!-- Card 3: Inactive Users -->
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #0F1523; -fx-background-radius: 15; -fx-border-color: rgba(239, 68, 68, 0.2); -fx-border-radius: 15; -fx-padding: 20;">
            <children>
                <Label text="COMPTES INACTIFS" textFill="#EF4444">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="lblInactiveUsers" text="0" textFill="WHITE">
                        <font><Font name="System Bold" size="28.0" /></font>
                    </Label>
                    <Label text="⛔" textFill="#EF4444" style="-fx-font-size: 20px;"/>
                </HBox>
            </children>
        </VBox>
    </HBox>

    <!-- SEARCH BAR & FILTER -->
    <HBox spacing="15.0">
        <ComboBox fx:id="statusFilter" onAction="#handleSearch" prefHeight="42.0" prefWidth="180.0"
                  promptText="Tous les statuts"
                  style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10; -fx-background-radius: 10; -fx-mark-color: white;" />

        <TextField fx:id="searchField" onKeyReleased="#handleSearch" prefHeight="42.0" prefWidth="380.0"
                   promptText="Rechercher un utilisateur..."
                   style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 15 0 15;" />
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS"
               stylesheets="dash.css"
               style="-fx-background-color: transparent; -fx-base: #06080F; -fx-control-inner-background: #06080F;">
        <columns>
            <TableColumn fx:id="colNom" prefWidth="150.0" text="NOM" />
            <TableColumn fx:id="colPrenom" prefWidth="150.0" text="PRÉNOM" />
            <TableColumn fx:id="colEmail" prefWidth="250.0" text="EMAIL" />
            <TableColumn fx:id="colRole" prefWidth="120.0" text="RÔLE" />
            <TableColumn fx:id="colActions" prefWidth="180.0" text="ACTIONS" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="lblPagination" textFill="#3A4258">
            <font><Font name="System Bold" size="11.0" /></font>
        </Label>
    </HBox>
</VBox>