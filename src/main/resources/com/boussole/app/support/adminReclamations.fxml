<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>

<VBox spacing="20" alignment="TOP_CENTER" prefHeight="750.0" prefWidth="950.0" 
      style="-fx-background-color: #f0f4f7;"
      fx:controller="com.boussole.app.controllers.AdminReclamationController"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <children>
        <VBox alignment="CENTER" spacing="5">
            <Label text="Administration Réclamations" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0E5384;" />
            <Label text="Supervision et traitement des demandes franchisés" 
                   style="-fx-font-size: 14px; -fx-text-fill: #4593CB;" />
        </VBox>

        <TableView fx:id="table" VBox.vgrow="ALWAYS" 
                   style="-fx-background-radius: 10; -fx-border-color: #4593CB; -fx-border-radius: 10; -fx-background-color: white;">
            <columns>
                <TableColumn fx:id="colSujet" text="Sujet" prefWidth="200" />
                <TableColumn fx:id="colDescription" text="Description" prefWidth="400" />
                <TableColumn fx:id="colStatut" text="Statut Actuel" prefWidth="120" />
                <TableColumn fx:id="colDate" text="Date de Création" prefWidth="150" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <effect>
                <DropShadow blurType="GAUSSIAN" height="10.0" radius="4.5" width="10.0" color="#0E538426" />
            </effect>
        </TableView>

        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-border-color: #4593CB; -fx-border-width: 0.5; -fx-border-radius: 15;">
            <effect>
                 <DropShadow blurType="GAUSSIAN" height="10.0" radius="4.5" width="10.0" color="#0E538426" />
            </effect>
            <children>
                <Label text="Traitement de la demande" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0E5384;" />
                
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Nouveau Statut :" style="-fx-font-weight: bold; -fx-text-fill: #4593CB;"/>
                        <ComboBox fx:id="statusComboBox" promptText="Sélectionner une action..." maxWidth="Infinity"
                                  style="-fx-padding: 8; -fx-background-radius: 5; -fx-border-color: #cbd5e0; -fx-font-size: 14px;"/>
                    </VBox>

                    <VBox alignment="BOTTOM_LEFT">
                         <Button text="✔ Mettre à jour le statut"  onAction="#updateStatus"
                            style="-fx-background-color: #0E5384; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;" />
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #ececec;" />

                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Label fx:id="errorLabel" text="Veuillez sélectionner une ligne !" 
                           visible="false" managed="false"
                           style="-fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-font-size: 13px;" />
                    
                    <Region HBox.hgrow="ALWAYS" />

                    <Button text="Supprimer la réclamation"  onAction="#delete"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 8; -fx-cursor: hand;" />
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
