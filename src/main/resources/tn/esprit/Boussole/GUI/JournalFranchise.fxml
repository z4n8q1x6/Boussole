<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CustomMenuItem?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.control.TextField?>
<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Boussole.GUI.JournalFranchiseController"
            fx:id="contentPane" prefWidth="1280" prefHeight="800"
            stylesheets="@styles.css">

    <!-- Sidebar gauche -->
    <left>
        <VBox spacing="10" styleClass="sidebar" prefWidth="240">
            <padding>
                <Insets top="30" right="20" bottom="30" left="20"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="sidebar-header">
                    <Label text="BOUSSOLE" style="-fx-text-fill: white; -fx-font-size:20px; -fx-font-weight:900; -fx-effect: dropshadow(gaussian, rgba(0,229,204,0.4), 10, 0, 0, 0);" />
                </HBox>

                <Label text="MENU PRINCIPAL" styleClass="section-label" />

                <Button fx:id="btnDashboard" text="Tableau de Bord" onAction="#versDashboard" styleClass="nav-button" maxWidth="Infinity" />
                <Button text="Journal Complet" styleClass="nav-button" maxWidth="Infinity" />

                <!-- Spacer -->
                <Pane VBox.vgrow="ALWAYS" />

                <!-- User Profile -->
                <VBox styleClass="user-footer">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Pane styleClass="avatar-circle">
                             <Label text="F" style="-fx-text-fill: #0F172A; -fx-font-weight:bold;"/>
                        </Pane>
                        <VBox spacing="2">
                             <Label text="Franchisé" style="-fx-text-fill: white; -fx-font-weight:bold; -fx-font-size:13px;"/>
                             <Label text="ID: 1" style="-fx-text-fill: #64748B; -fx-font-size:11px;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- Contenu Principal -->
    <center>
        <VBox spacing="30" styleClass="content-area">
            <children>

                <!-- Titre -->
                <VBox styleClass="page-header">
                    <Label text="Journal des Opérations" styleClass="page-title" />
                    <Label text="Historique détaillé et statistiques" styleClass="page-subtitle" />
                </VBox>

                <!-- Barre de Filtres -->
                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="kpi-card" style="-fx-padding: 20;">
                    <children>
                        <!-- Filtre Période hybride (rapide + plage personnalisée) -->
                        <VBox spacing="8">
                            <Label text="Période" style="-fx-text-fill: #94A3B8; -fx-font-size:11px; -fx-font-weight:bold;"/>
                            <MenuButton fx:id="btnPeriode" text="📅 Période : Ce Mois" prefWidth="220"
                                        style="-fx-background-color: #112240; -fx-text-fill: #FFFFFF; -fx-background-radius: 30; -fx-border-radius: 30; -fx-border-color: #233554; -fx-border-width: 1; -fx-padding: 8 15;">
                                <items>
                                    <MenuItem fx:id="miCeMois" text="Ce Mois" />
                                    <MenuItem fx:id="miMoisDernier" text="Mois Dernier" />
                                    <MenuItem fx:id="miCetteAnnee" text="Cette Année" />
                                    <SeparatorMenuItem />
                                    <!-- Panneau personnalisé cohérent avec le thème -->
                                    <CustomMenuItem hideOnClick="false">
                                        <content>
                                            <!-- Carte sombre alignée avec le template -->
                                            <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #020617;">
                                                <Label text="Plage personnalisée" style="-fx-text-fill: #E5E7EB; -fx-font-size:11px; -fx-font-weight:bold;" />
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <DatePicker fx:id="dpPeriodeDu" promptText="Du..." prefWidth="120"
                                                                style="-fx-background-color: #020617; -fx-control-inner-background: #020617; -fx-text-fill: #E5E7EB; -fx-background-radius: 22; -fx-border-radius: 22; -fx-border-color: #1F2937; -fx-border-width: 1;" />
                                                    <DatePicker fx:id="dpPeriodeAu" promptText="Au..." prefWidth="120"
                                                                style="-fx-background-color: #020617; -fx-control-inner-background: #020617; -fx-text-fill: #E5E7EB; -fx-background-radius: 22; -fx-border-radius: 22; -fx-border-color: #1F2937; -fx-border-width: 1;" />
                                                    <Button fx:id="btnPeriodeOk" text="OK"
                                                            style="-fx-background-color: #0ea5e9; -fx-text-fill: #000000; -fx-font-weight: 800; -fx-background-radius: 22; -fx-padding: 6 18;" />
                                                </HBox>
                                            </VBox>
                                        </content>
                                    </CustomMenuItem>
                                </items>
                            </MenuButton>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Type" style="-fx-text-fill: #94A3B8; -fx-font-size:11px; -fx-font-weight:bold;"/>
                            <ComboBox fx:id="cbTypeFiltre" promptText="TOUT" prefWidth="150"
                                      style="-fx-background-color: #112240; -fx-text-fill: #FFFFFF; -fx-background-radius: 30; -fx-border-radius: 30; -fx-border-color: #233554; -fx-border-width: 1; -fx-padding: 8 15;
                                             -fx-control-inner-background: #112240; -fx-accent: #0a84ff; -fx-cell-hover-color: #233554;" />
                        </VBox>

                        <Pane HBox.hgrow="ALWAYS" />

                        <TextField fx:id="txtRechercheGlobal" promptText="🔍 Rechercher dans la description..." prefWidth="250"
                                   style="-fx-background-color: #112240; -fx-text-fill: #e6f1ff; -fx-background-radius: 30; -fx-border-radius: 30; -fx-border-color: #233554; -fx-border-width: 1; -fx-padding: 8 15;" />
                        <Button fx:id="btnReinitialiser" text="Réinitialiser" onAction="#reinitialiserFiltres" styleClass="nav-button"
                                style="-fx-background-color: #112240; -fx-text-fill: #e6f1ff; -fx-background-radius: 30; -fx-border-radius: 30; -fx-border-color: #233554; -fx-border-width: 1; -fx-padding: 8 15;" />
                        <!-- Bouton Exporter avec texte noir -->
                        <Button fx:id="btnExporter" text="Exporter ..." onAction="#exporterCSV" styleClass="button-primary"
                                style="-fx-background-color: #0a84ff; -fx-text-fill: #000000; -fx-font-weight:bold; -fx-background-radius: 30; -fx-border-radius: 30; -fx-border-color: #233554; -fx-border-width: 1; -fx-padding: 8 15;" />
                    </children>
                </HBox>

                <!-- TableView -->
                <VBox styleClass="kpi-card" VBox.vgrow="ALWAYS" style="-fx-padding:0;">
                    <children>
                        <TableView fx:id="tableTransactions" VBox.vgrow="ALWAYS" styleClass="journal-table-view"
                                   style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colDate" text="DATE" prefWidth="110"/>
                                <TableColumn fx:id="colType" text="TYPE" prefWidth="90"/>
                                <TableColumn fx:id="colDescription" text="DESCRIPTION" prefWidth="280"/>
                                <TableColumn fx:id="colMontant" text="MONTANT (TND)" prefWidth="130"/>
                                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="150"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="Aucune transaction trouvée" style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>

                <!-- KPIs Footer -->
                <HBox spacing="20">
                    <children>
                        <VBox styleClass="user-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                            <Label text="Nombre Transactions" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                            <Label fx:id="lblNombreTransactions" text="--" styleClass="kpi-value" style="-fx-font-size: 20px; -fx-text-fill: #0b3d91;"/>
                        </VBox>
                        <VBox styleClass="user-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                            <Label text="Total Recettes" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                            <Label fx:id="lblTotalRecettes" text="-- TND" styleClass="kpi-value" style="-fx-font-size: 20px; -fx-text-fill: #2e7d32;"/>
                        </VBox>
                        <VBox styleClass="user-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                            <Label text="Total Charges" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                            <Label fx:id="lblTotalCharges" text="-- TND" styleClass="kpi-value" style="-fx-font-size: 20px; -fx-text-fill: #c62828;"/>
                        </VBox>
                        <VBox styleClass="user-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                            <Label text="Solde Filtré" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                            <Label fx:id="lblSoldeFiltre" text="-- TND" styleClass="kpi-value" style="-fx-font-size: 20px; -fx-text-fill: #0b3d91;"/>
                        </VBox>
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>
