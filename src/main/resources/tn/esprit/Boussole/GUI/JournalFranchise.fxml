<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Boussole.GUI.JournalFranchiseController"
            fx:id="contentPane" prefWidth="1280" prefHeight="800"
            stylesheets="@styles.css">

    <!-- Sidebar gauche -->
    <left>
        <VBox spacing="10" styleClass="sidebar" prefWidth="240">
            <padding>
                <Insets top="30" right="20" bottom="30" left="20"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="sidebar-header">
                    <Label text="BOUSSOLE" style="-fx-text-fill: white; -fx-font-size:20px; -fx-font-weight:900; -fx-effect: dropshadow(gaussian, rgba(0,229,204,0.4), 10, 0, 0, 0);" />
                </HBox>

                <Label text="MENU PRINCIPAL" styleClass="section-label" />

                <Button fx:id="btnDashboard" text="Tableau de Bord" onAction="#versDashboard" styleClass="nav-button" maxWidth="Infinity" />
                <Button text="Journal Complet" styleClass="nav-button" maxWidth="Infinity" />

                <!-- Spacer -->
                <Pane VBox.vgrow="ALWAYS" />

                <!-- User Profile -->
                <VBox styleClass="user-footer">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Pane styleClass="avatar-circle">
                             <Label text="F" style="-fx-text-fill: #0F172A; -fx-font-weight:bold;"/>
                        </Pane>
                        <VBox spacing="2">
                             <Label text="Franchisé" style="-fx-text-fill: white; -fx-font-weight:bold; -fx-font-size:13px;"/>
                             <Label text="ID: 1" style="-fx-text-fill: #64748B; -fx-font-size:11px;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- Contenu Principal -->
    <center>
        <VBox spacing="30" styleClass="content-area">
            <children>

                <!-- Titre -->
                <VBox styleClass="page-header">
                    <Label text="Journal des Opérations" styleClass="page-title" />
                    <Label text="Historique détaillé et statistiques" styleClass="page-subtitle" />
                </VBox>

                <!-- Barre de Filtres -->
                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="kpi-card" style="-fx-padding: 20;">
                    <children>
                        <VBox spacing="8">
                            <Label text="Date Début" style="-fx-text-fill: #94A3B8; -fx-font-size:11px; -fx-font-weight:bold;"/>
                            <DatePicker fx:id="dpDateDebut" promptText="Du..." />
                        </VBox>
                        <VBox spacing="8">
                            <Label text="Date Fin" style="-fx-text-fill: #94A3B8; -fx-font-size:11px; -fx-font-weight:bold;"/>
                            <DatePicker fx:id="dpDateFin" promptText="Au..." />
                        </VBox>
                        <VBox spacing="8">
                            <Label text="Type" style="-fx-text-fill: #94A3B8; -fx-font-size:11px; -fx-font-weight:bold;"/>
                            <ComboBox fx:id="cbTypeFiltre" promptText="TOUT" prefWidth="150" />
                        </VBox>

                        <Pane HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnRechercher" text="Rechercher" onAction="#appliquerFiltres" styleClass="button-primary" />
                        <Button fx:id="btnReinitialiser" text="Réinitialiser" onAction="#reinitialiserFiltres" styleClass="nav-button" style="-fx-background-color: rgba(255,255,255,0.05);" />
                        <Button fx:id="btnExporter" text="Exporter ..." onAction="#exporterCSV" styleClass="button-primary" style="-fx-background-color: linear-gradient(to right, #3B82F6, #2563EB);" />
                    </children>
                </HBox>

                <!-- TableView -->
                <VBox styleClass="kpi-card" VBox.vgrow="ALWAYS" style="-fx-padding:0;">
                    <children>
                        <TableView fx:id="tableTransactions" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
                                <TableColumn fx:id="colType" text="Type" prefWidth="90"/>
                                <TableColumn fx:id="colDescription" text="Description" prefWidth="280"/>
                                <TableColumn fx:id="colMontant" text="Montant (TND)" prefWidth="130"/>
                                <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="Aucune transaction trouvée" style="-fx-text-fill: #66788a;"/>
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>

                <!-- 4 KPI Cards -->
                <HBox spacing="20" alignment="CENTER" styleClass="kpi-card" style="-fx-padding: 30;">
                    <children>
                        <!-- Nombre Transactions -->
                        <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Nombre Transactions" styleClass="kpi-title"/>
                            <Label fx:id="lblNombreTransactions" text="0" styleClass="kpi-value" style="-fx-text-fill: #0B3D91;" />
                        </VBox>

                        <Separator orientation="VERTICAL" />

                        <!-- Total Recettes -->
                        <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Total Recettes" styleClass="kpi-title"/>
                            <Label fx:id="lblTotalRecettes" text="0.00 TND" styleClass="kpi-value" style="-fx-text-fill: #2e7d32;" />
                        </VBox>

                        <Separator orientation="VERTICAL" />

                        <!-- Total Charges -->
                        <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Total Charges" styleClass="kpi-title"/>
                            <Label fx:id="lblTotalCharges" text="0.00 TND" styleClass="kpi-value" style="-fx-text-fill: #c62828;" />
                        </VBox>

                        <Separator orientation="VERTICAL" />

                        <!-- Solde Filtré -->
                        <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Solde Filtré" styleClass="kpi-title"/>
                            <Label fx:id="lblSoldeFiltre" text="0.00 TND" styleClass="kpi-value" style="-fx-text-fill: #0B3D91;" />
                        </VBox>
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>
