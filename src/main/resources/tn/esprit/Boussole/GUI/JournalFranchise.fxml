<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.Boussole.GUI.JournalFranchiseController"
            prefHeight="700.0" prefWidth="1100.0"
            style="-fx-background-color: #f6f8fb;">

    <!-- Sidebar gauche (Style Siège) -->
    <left>
        <VBox spacing="15" style="-fx-background-color: linear-gradient(#05243a, #0b3d91); -fx-pref-width:220; -fx-padding:20;">
            <children>
                <Label text="Boussole" style="-fx-text-fill: white; -fx-font-size:18px; -fx-font-weight:bold;" />

                <Button fx:id="btnDashboard" text="Tableau de Bord" onAction="#versDashboard"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size:14px; -fx-padding:8 12 8 12; -fx-border-color: transparent; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
                <Button text="Journal Complet"
                        maxWidth="Infinity"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size:14px; -fx-padding:8 12 8 12; -fx-border-color: transparent; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-font-weight: bold; -fx-background-radius: 5;"/>

                <!-- Spacer -->
                <Pane VBox.vgrow="ALWAYS" />

                <Label text="v1.0" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size:11px;" />
            </children>
        </VBox>
    </left>

    <!-- Contenu Principal -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <children>

                <!-- Titre -->
                <Label text="Journal Complet" style="-fx-text-fill: #0b3d91; -fx-font-size:28px; -fx-font-weight:bold;" />

                <!-- Barre de Filtres -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(10,25,47,0.12), 10, 0, 0, 4);">
                    <children>
                        <VBox spacing="5">
                            <children>
                                <Label text="Date Début" style="-fx-text-fill: #66788a; -fx-font-size:11px;"/>
                                <DatePicker fx:id="dpDateDebut" promptText="Du..."/>
                            </children>
                        </VBox>
                        <VBox spacing="5">
                            <children>
                                <Label text="Date Fin" style="-fx-text-fill: #66788a; -fx-font-size:11px;"/>
                                <DatePicker fx:id="dpDateFin" promptText="Au..."/>
                            </children>
                        </VBox>
                        <VBox spacing="5">
                            <children>
                                <Label text="Type" style="-fx-text-fill: #66788a; -fx-font-size:11px;"/>
                                <ComboBox fx:id="cbTypeFiltre" promptText="TOUT" prefWidth="130"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnRechercher" text="Rechercher" onAction="#appliquerFiltres"
                                style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 15;"/>

                        <Button fx:id="btnReinitialiser" text="Réinitialiser" onAction="#reinitialiserFiltres"
                                style="-fx-background-color: #78909c; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 15;"/>

                        <Button fx:id="btnExporter" text="Exporter CSV" onAction="#exporterCSV"
                                style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 15;"/>
                    </children>
                </HBox>

                <!-- TableView -->
                <TableView fx:id="tableTransactions" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(10,25,47,0.12), 10, 0, 0, 4);">
                    <columns>
                        <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="90"/>
                        <TableColumn fx:id="colDescription" text="Description" prefWidth="280"/>
                        <TableColumn fx:id="colMontant" text="Montant (TND)" prefWidth="130"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Aucune transaction trouvée" style="-fx-text-fill: #66788a;"/>
                    </placeholder>
                </TableView>

                <!-- 4 KPI Cards -->
                <HBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(10,25,47,0.12), 10, 0, 0, 4);">
                    <children>
                        <!-- Nombre Transactions -->
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Nombre Transactions" style="-fx-text-fill: #66788a; -fx-font-size:12px;"/>
                                <Label fx:id="lblNombreTransactions" text="0" style="-fx-text-fill: #0b3d91; -fx-font-size:22px; -fx-font-weight:bold;"/>
                            </children>
                        </VBox>

                        <Separator orientation="VERTICAL" />

                        <!-- Total Recettes -->
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Total Recettes" style="-fx-text-fill: #66788a; -fx-font-size:12px;"/>
                                <Label fx:id="lblTotalRecettes" text="0.00 TND" style="-fx-text-fill: #2e7d32; -fx-font-size:22px; -fx-font-weight:bold;"/>
                            </children>
                        </VBox>

                        <Separator orientation="VERTICAL" />

                        <!-- Total Charges -->
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Total Charges" style="-fx-text-fill: #66788a; -fx-font-size:12px;"/>
                                <Label fx:id="lblTotalCharges" text="0.00 TND" style="-fx-text-fill: #c62828; -fx-font-size:22px; -fx-font-weight:bold;"/>
                            </children>
                        </VBox>

                        <Separator orientation="VERTICAL" />

                        <!-- Solde Filtré -->
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Solde Filtré" style="-fx-text-fill: #66788a; -fx-font-size:12px;"/>
                                <Label fx:id="lblSoldeFiltre" text="0.00 TND" style="-fx-text-fill: #0b3d91; -fx-font-size:22px; -fx-font-weight:bold;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>
