<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.Boussole.GUI.JournalTransactionsController"
      spacing="15"
      style="-fx-background-color: #ecf0f1; -fx-padding: 20;">

    <!-- 1. TITRE -->
    <HBox alignment="CENTER">
        <Label text="📊 Journal des Mouvements Financiers" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
    </HBox>

    <!-- 2. BARRE DE FILTRES -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;">
        <VBox spacing="5">
            <Label text="Date Début" textFill="#7f8c8d"/>
            <DatePicker fx:id="dpDateDebut" promptText="Sélectionner..."/>
        </VBox>

        <VBox spacing="5">
            <Label text="Date Fin" textFill="#7f8c8d"/>
            <DatePicker fx:id="dpDateFin" promptText="Sélectionner..."/>
        </VBox>

        <VBox spacing="5">
            <Label text="Type" textFill="#7f8c8d"/>
            <ComboBox fx:id="cbTypeFiltre" promptText="TOUT" prefWidth="150"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnRechercher" text="🔍 Rechercher" onAction="#appliquerFiltres"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>

        <Button fx:id="btnReinitialiser" text="🔄 Réinitialiser" onAction="#reinitialiserFiltres"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>

        <Button fx:id="btnExporter" text="📥 Exporter CSV" onAction="#exporterCSV"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </HBox>

    <!-- 3. TABLEVIEW -->
    <TableView fx:id="tableTransactions" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
            <TableColumn fx:id="colMontant" text="Montant (TND)" prefWidth="150"/>
            <TableColumn fx:id="colDescription" text="Description" prefWidth="300"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Aucune transaction trouvée"/>
        </placeholder>
    </TableView>

    <!-- 4. BARRE DE STATISTIQUES -->
    <HBox spacing="30" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;">
        <VBox alignment="CENTER" spacing="5">
            <Label text="Nombre Transactions" textFill="#7f8c8d">
                <font><Font size="14.0"/></font>
            </Label>
            <Label fx:id="lblNombreTransactions" text="0">
                <font><Font name="System Bold" size="18.0"/></font>
            </Label>
        </VBox>

        <Separator orientation="VERTICAL" />

        <VBox alignment="CENTER" spacing="5">
            <Label text="Total Recettes" textFill="#7f8c8d">
                <font><Font size="14.0"/></font>
            </Label>
            <Label fx:id="lblTotalRecettes" text="0.00 TND" textFill="#27ae60">
                <font><Font name="System Bold" size="18.0"/></font>
            </Label>
        </VBox>

        <Separator orientation="VERTICAL" />

        <VBox alignment="CENTER" spacing="5">
            <Label text="Total Charges" textFill="#7f8c8d">
                <font><Font size="14.0"/></font>
            </Label>
            <Label fx:id="lblTotalCharges" text="0.00 TND" textFill="#e74c3c">
                <font><Font name="System Bold" size="18.0"/></font>
            </Label>
        </VBox>

        <Separator orientation="VERTICAL" />

        <VBox alignment="CENTER" spacing="5">
            <Label text="Solde Filtré" textFill="#7f8c8d">
                <font><Font size="14.0"/></font>
            </Label>
            <Label fx:id="lblSoldeFiltre" text="0.00 TND" textFill="#3498db">
                <font><Font name="System Bold" size="18.0"/></font>
            </Label>
        </VBox>
    </HBox>

</VBox>
