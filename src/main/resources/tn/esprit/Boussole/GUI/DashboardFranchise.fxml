<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Boussole.GUI.DashboardFranchiseController" fx:id="contentPane">

    <!-- Sidebar gauche -->
    <left>
        <VBox spacing="15" style="-fx-background-color: linear-gradient(#05243a, #0b3d91); -fx-pref-width:220; -fx-padding:20;" >
            <children>
                <Label text="Boussole" style="-fx-text-fill: white; -fx-font-size:18px; -fx-font-weight:bold;" />

                <Button fx:id="btnDashboard" text="Tableau de Bord" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size:14px; -fx-padding:8 12 8 12; -fx-border-color: transparent; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 5;" />
                <Button fx:id="btnHistorique" text="Journal Complet" onAction="#versHistorique" 
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size:14px; -fx-padding:8 12 8 12; -fx-border-color: transparent; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;" maxWidth="Infinity"/>

                <!-- Spacer -->
                <Pane VBox.vgrow="ALWAYS" />

                <Label fx:id="lblUserInfo" text="Franchise ID: 1" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size:11px;" />
            </children>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox spacing="20" style="-fx-background-color: #f6f8fb; -fx-padding:20;">
            <children>
                <Label text="Tableau de Bord Franchise" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill: #0b3d91;" />

                <!-- KPI Cards -->
                <HBox spacing="15">
                    <children>
                        <StackPane prefWidth="300" prefHeight="120" style="-fx-background-color: white; -fx-background-radius:10; -fx-effect: dropshadow(three-pass-box, rgba(10,25,47,0.12), 10, 0, 0, 4); -fx-padding:12;">
                            <children>
                                <Pane fx:id="paneKpi" style="-fx-background-color: transparent;" />
                                <VBox spacing="6" style="-fx-alignment: center; -fx-padding:10;">
                                    <children>
                                        <Label text="Solde Disponible" style="-fx-text-fill: #66788a; -fx-font-size:13px; -fx-font-weight:bold;" />
                                        <Label fx:id="lblSolde" text="0.00 TND" style="-fx-text-fill: #2e7d32; -fx-font-size:34px; -fx-font-weight:bold;" />
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>

                        <!-- Budget KPI: Limite Dépenses -->
                        <StackPane prefWidth="220" prefHeight="120" style="-fx-background-color: white; -fx-background-radius:10; -fx-effect: dropshadow(three-pass-box, rgba(10,25,47,0.12), 10, 0, 0, 4); -fx-padding:12;">
                            <children>
                                <VBox spacing="6" style="-fx-alignment: center; -fx-padding:10;">
                                    <children>
                                        <Label text="Limite Dépenses" style="-fx-text-fill: #66788a; -fx-font-size:12px; -fx-font-weight:bold;" />
                                        <Label fx:id="lblLimiteDepenses" text="— TND" style="-fx-text-fill: #c62828; -fx-font-size:20px; -fx-font-weight:bold;" />
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>

                        <!-- Budget KPI: Objectif Revenu -->
                        <StackPane prefWidth="220" prefHeight="120" style="-fx-background-color: white; -fx-background-radius:10; -fx-effect: dropshadow(three-pass-box, rgba(10,25,47,0.12), 10, 0, 0, 4); -fx-padding:12;">
                            <children>
                                <VBox spacing="6" style="-fx-alignment: center; -fx-padding:10;">
                                    <children>
                                        <Label text="Objectif Revenu" style="-fx-text-fill: #66788a; -fx-font-size:12px; -fx-font-weight:bold;" />
                                        <Label fx:id="lblObjectifRevenu" text="— TND" style="-fx-text-fill: #2e7d32; -fx-font-size:20px; -fx-font-weight:bold;" />
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </children>
                </HBox>

                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Formulaire Saisie Rapide -->
                        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(10,25,47,0.08), 8, 0, 0, 3); -fx-pref-width: 280;">
                            <children>
                                <Label text="Saisie Rapide Recette" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0b3d91;" />
                                <VBox spacing="5">
                                    <children>
                                        <Label text="Date" style="-fx-text-fill: #66788a; -fx-font-size: 11px;" />
                                        <DatePicker fx:id="dpDate" style="-fx-font-size: 12px;" />
                                    </children>
                                </VBox>
                                <VBox spacing="5">
                                    <children>
                                        <Label text="Montant (TND)" style="-fx-text-fill: #66788a; -fx-font-size: 11px;" />
                                        <TextField fx:id="tfMontant" promptText="Ex: 5000" style="-fx-font-size: 12px; -fx-padding: 8;" />
                                    </children>
                                </VBox>
                                <VBox spacing="5">
                                    <children>
                                        <Label text="Description" style="-fx-text-fill: #66788a; -fx-font-size: 11px;" />
                                        <TextField fx:id="tfDescription" promptText="Ex: Vente Journalière" style="-fx-font-size: 12px; -fx-padding: 8;" />
                                    </children>
                                </VBox>
                                <Button fx:id="btnValider" text="Valider Recette" style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-color: #2e7d32; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" maxWidth="Infinity"/>
                            </children>
                        </VBox>

                        <!-- Centre: Mouvements -->
                        <VBox spacing="15" HBox.hgrow="ALWAYS">
                            <children>
                                <!-- Derniers Mouvements -->
                                <VBox spacing="8" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="Derniers Mouvements" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0b3d91;" />
                                        <TableView fx:id="tableMovements" style="-fx-background-color: white; -fx-background-radius:8; -fx-effect: dropshadow(two-pass-box, rgba(10,25,47,0.06), 8, 0, 0, 3);" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn prefWidth="120" text="Date" fx:id="colDate" />
                                                <TableColumn prefWidth="100" text="Type" fx:id="colType" />
                                                <TableColumn prefWidth="200" text="Description" fx:id="colDescription" />
                                                <TableColumn prefWidth="120" text="Montant (TND)" fx:id="colMontant" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

</BorderPane>
