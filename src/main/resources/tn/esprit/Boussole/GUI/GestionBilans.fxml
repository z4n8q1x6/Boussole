<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Boussole.GUI.GestionBilansController" fx:id="contentPane" prefWidth="1280" prefHeight="800" stylesheets="@styles.css">

    <!-- Sidebar gauche -->
    <left>
        <VBox spacing="10" styleClass="sidebar" prefWidth="240">
            <padding>
                <Insets top="30" right="20" bottom="30" left="20"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="sidebar-header">
                    <Label text="BOUSSOLE" style="-fx-text-fill: white; -fx-font-size:20px; -fx-font-weight:900; -fx-effect: dropshadow(gaussian, rgba(0,229,204,0.4), 10, 0, 0, 0);" />
                </HBox>

                <Label text="MENU PRINCIPAL" styleClass="section-label" />

                <Button fx:id="btnDashboard" text="Tableau de Bord" styleClass="nav-button" maxWidth="Infinity" />
                <Button fx:id="btnBudgets" text="Budgets" styleClass="nav-button" maxWidth="Infinity" />
                <Button fx:id="btnBilans" text="Bilans" styleClass="nav-button" maxWidth="Infinity" />

                <!-- Spacer -->
                <Pane VBox.vgrow="ALWAYS" />

                <!-- User Profile -->
                <VBox styleClass="user-footer">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Pane styleClass="avatar-circle">
                             <Label text="S" style="-fx-text-fill: #0F172A; -fx-font-weight:bold;"/>
                        </Pane>
                        <VBox spacing="2">
                             <Label text="Siège" style="-fx-text-fill: white; -fx-font-weight:bold; -fx-font-size:13px;"/>
                             <Label text="Admin" style="-fx-text-fill: #64748B; -fx-font-size:11px;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- Centre -->
    <center>
        <VBox spacing="30" styleClass="content-area">
            <children>
                <!-- Entête -->
                <VBox styleClass="page-header">
                    <Label text="Reporting Financier" styleClass="page-title" />
                    <Label text="Génération et export des bilans mensuels" styleClass="page-subtitle" />
                </VBox>

                <!-- Zone d'action et Table -->
                <VBox styleClass="kpi-card" VBox.vgrow="ALWAYS" spacing="20">
                    <padding>
                        <Insets top="20" right="25" bottom="25" left="25"/>
                    </padding>
                    <children>
                        <!-- Bouton Générer Bilan -->
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Button fx:id="btnGenererBilan" text="📊 GÉNÉRER BILAN MENSUEL" styleClass="button-primary" />
                            <Button fx:id="btnExporterPDF" text="📥 EXPORTER PDF" styleClass="button-primary" style="-fx-background-color: linear-gradient(to right, #3B82F6, #2563EB);" />
                            <Pane HBox.hgrow="ALWAYS" />
                            <Label text="Sélectionnez une ligne pour exporter" style="-fx-text-fill: #64748B; -fx-font-style: italic; -fx-font-size: 12px;" />
                        </HBox>

                        <Label text="Historique des Bilans" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" />

                        <!-- TableView Historique Bilans -->
                        <TableView fx:id="tableBilans" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colMois" text="MOIS" prefWidth="80" />
                                <TableColumn fx:id="colAnnee" text="ANNÉE" prefWidth="80" />
                                <TableColumn fx:id="colRecettes" text="TOTAL RECETTES (TND)" prefWidth="180" />
                                <TableColumn fx:id="colCharges" text="TOTAL CHARGES (TND)" prefWidth="180" />
                                <TableColumn fx:id="colResultat" text="RÉSULTAT NET (TND)" prefWidth="180" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

</BorderPane>
