<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Boussole.GUI.LoginController"
           prefWidth="1280" prefHeight="800" stylesheets="@styles.css" styleClass="content-area">

    <VBox spacing="40" alignment="CENTER" maxWidth="450" maxHeight="350" styleClass="kpi-card" style="-fx-padding: 50;">

        <Label text="BOUSSOLE" style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,229,204,0.4), 10, 0, 0, 0);" />

        <Label text="Bienvenue" style="-fx-font-size: 18px; -fx-text-fill: #94A3B8;" />

        <VBox spacing="20" alignment="CENTER" maxWidth="350" VBox.vgrow="ALWAYS">
            <Button fx:id="btnSiege" text="ACCÈS SIÈGE" maxWidth="Infinity" styleClass="button-primary" style="-fx-font-size: 14px; -fx-padding: 15;" />
            <Button fx:id="btnFranchise" text="ACCÈS FRANCHISE" maxWidth="Infinity" styleClass="nav-button" style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: white; -fx-font-size: 14px; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-background-radius: 12; -fx-border-radius: 12;" />
        </VBox>

        <Label text="Sélectionnez votre espace pour continuer" style="-fx-text-fill: #64748B; -fx-font-size: 12px;" />
    </VBox>
</StackPane>
