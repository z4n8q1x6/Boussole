<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Boussole.GUI.GestionBudgetsController" fx:id="contentPane" prefWidth="1280" prefHeight="800" stylesheets="@styles.css">

    <!-- Sidebar gauche -->
    <left>
        <VBox spacing="10" styleClass="sidebar" prefWidth="240">
            <padding>
                <Insets top="30" right="20" bottom="30" left="20"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="sidebar-header">
                    <Label text="BOUSSOLE" style="-fx-text-fill: white; -fx-font-size:20px; -fx-font-weight:900; -fx-effect: dropshadow(gaussian, rgba(0,229,204,0.4), 10, 0, 0, 0);" />
                </HBox>

                <Label text="MENU PRINCIPAL" styleClass="section-label" />

                <Button fx:id="btnDashboard" text="Tableau de Bord" styleClass="nav-button" maxWidth="Infinity" />
                <Button fx:id="btnBudgets" text="Budgets" styleClass="nav-button" maxWidth="Infinity" />
                <Button fx:id="btnBilans" text="Bilans" styleClass="nav-button" maxWidth="Infinity" />

                <!-- Spacer -->
                <Pane VBox.vgrow="ALWAYS" />

                <!-- User Profile -->
                <VBox styleClass="user-footer">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Pane styleClass="avatar-circle">
                             <Label text="S" style="-fx-text-fill: #0F172A; -fx-font-weight:bold;"/>
                        </Pane>
                        <VBox spacing="2">
                             <Label text="Siège" style="-fx-text-fill: white; -fx-font-weight:bold; -fx-font-size:13px;"/>
                             <Label text="Admin" style="-fx-text-fill: #64748B; -fx-font-size:11px;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- Centre -->
    <center>
        <VBox spacing="30" styleClass="content-area">
            <children>
                <!-- Entête -->
                <VBox styleClass="page-header">
                    <Label text="Stratégie Budgétaire" styleClass="page-title" />
                    <Label text="Définition et suivi des objectifs financiers du réseau" styleClass="page-subtitle" />
                </VBox>

                <HBox spacing="25" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Formulaire Création/Modification -->
                        <VBox styleClass="kpi-card" prefWidth="350" spacing="20">
                            <padding>
                                <Insets top="25" right="25" bottom="25" left="25"/>
                            </padding>
                            <children>
                                <Label text="Gestion du Budget" style="-fx-font-size:16px; -fx-font-weight: bold; -fx-text-fill: white;" />

                                <HBox spacing="10">
                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Mois" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight:bold;" />
                                        <ComboBox fx:id="cbMois" maxWidth="Infinity" />
                                    </VBox>
                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Année" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight:bold;" />
                                        <ComboBox fx:id="cbAnnee" maxWidth="Infinity" />
                                    </VBox>
                                </HBox>

                                <VBox spacing="8">
                                    <Label text="Type de Budget" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight:bold;" />
                                    <ComboBox fx:id="cbTypeBudget" maxWidth="Infinity" />
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Catégorie" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight:bold;" />
                                    <ComboBox fx:id="cbCategorie" maxWidth="Infinity" />
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Montant Cible (TND)" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight:bold;" />
                                    <TextField fx:id="txtMontant" promptText="0.00" />
                                </VBox>

                                <CheckBox fx:id="chkReseau" text="Appliquer à tout le réseau" style="-fx-text-fill: #CBD5E1; -fx-font-size:12px;" />

                                <Pane VBox.vgrow="ALWAYS" />

                                <HBox spacing="15">
                                    <Button fx:id="btnVider" text="Effacer" styleClass="nav-button" style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: #94A3B8;" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                    <Button fx:id="btnSauvegarder" text="SAUVEGARDER" styleClass="button-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                </HBox>
                            </children>
                        </VBox>

                        <!-- TableView Liste -->
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="15">
                            <padding>
                                <Insets top="20" right="20" bottom="20" left="20"/>
                            </padding>
                            <children>
                                <Label text="Budgets Configurés" style="-fx-font-size:16px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                <TableView fx:id="tableBudgets" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colMois" text="MOIS" prefWidth="60" />
                                        <TableColumn fx:id="colAnnee" text="ANNÉE" prefWidth="70" />
                                        <TableColumn fx:id="colType" text="TYPE" prefWidth="140" />
                                        <TableColumn fx:id="colCategorie" text="CATÉGORIE" prefWidth="150" />
                                        <TableColumn fx:id="colMontant" text="MONTANT (TND)" prefWidth="120" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>

