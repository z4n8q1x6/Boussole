<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="content-area" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.franchise.MesCommandesController">
    <padding><Insets bottom="25" left="25" right="25" top="25"/></padding>

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
            <Image url="@/images/orders.png" />
        </ImageView>
        <Label styleClass="page-title" text="Mes commandes" />
    </HBox>

    <!-- Statistiques -->
    <HBox spacing="15">
        <VBox styleClass="stat-card">
            <Label styleClass="stat-label" text="TOTAL COMMANDES" />
            <Label fx:id="totalCommandesLabel" styleClass="stat-value" text="0" />
        </VBox>
        <VBox styleClass="stat-card" style="-fx-border-color: #0EA5E9;">
            <Label styleClass="stat-label" text="TOTAL DÉPENSÉ" />
            <Label fx:id="totalDepenseLabel" styleClass="stat-value" text="0 DT" />
        </VBox>
    </HBox>

    <!-- Filtres -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Filtrer par statut:" styleClass="form-label" style="-fx-text-fill: #94A3B8;"/>
        <ComboBox fx:id="filtreStatutCombo" prefWidth="200" prefHeight="38"
                  style="-fx-background-color: #0F1523; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;"/>
        <Button onAction="#handleRefresh" styleClass="action-button" text="Rafraîchir" prefHeight="38"/>
    </HBox>

    <!-- Tableau des commandes - EN-TÊTES CORRIGÉS -->
    <TableView fx:id="commandeTable" VBox.vgrow="ALWAYS" prefHeight="400"
               style="-fx-background-color: transparent; -fx-border-color: #334155; -fx-border-radius: 12; -fx-background-radius: 12;">
        <columns>
            <TableColumn fx:id="colDate" prefWidth="200" text="DATE" />
            <TableColumn fx:id="colTotal" prefWidth="150" text="TOTAL" />
            <TableColumn fx:id="colStatut" prefWidth="150" text="STATUT" />
            <TableColumn fx:id="colActions" prefWidth="150" text="ACTIONS" />
        </columns>
    </TableView>

    <!-- Boutons de filtre rapide -->
    <HBox spacing="15" alignment="CENTER">
        <Button onAction="#handleEnAttente" styleClass="edit-button" text="⏳ En attente" prefHeight="38" prefWidth="120"/>
        <Button onAction="#handleValidees" styleClass="validate-button" text="✅ Validées" prefHeight="38" prefWidth="120"/>
        <Button onAction="#handleRefusees" styleClass="delete-button" text="❌ Refusées" prefHeight="38" prefWidth="120"/>
        <Button onAction="#handleVoirToutes" styleClass="action-button" text="📋 Toutes" prefHeight="38" prefWidth="120"/>
    </HBox>
</VBox>