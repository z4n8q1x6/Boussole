<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #0B0F1A;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.franchise.PanierController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <!-- En-tête -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="🛍️ Mon Panier" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="nbArticlesLabel" style="-fx-background-color: #0EA5E9; -fx-background-radius: 15; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15;" text="0" />
            </children>
        </HBox>

        <!-- Liste des articles -->
        <ListView fx:id="panierList" prefHeight="400.0" style="-fx-background-color: transparent; -fx-border-color: #334155; -fx-border-radius: 5;" VBox.vgrow="ALWAYS" />

        <!-- Récapitulatif et actions -->
        <VBox spacing="15.0" style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 20;">
            <children>
                <!-- Total -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 16px;" text="Total :" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="totalLabel" style="-fx-text-fill: #0EA5E9; -fx-font-size: 24px; -fx-font-weight: bold;" text="0.00 DT" />
                    </children>
                </HBox>

                <Separator style="-fx-background-color: #334155;" />

                <!-- Boutons d'action -->
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                    <children>
                        <Button fx:id="viderPanierBtn" onAction="#handleViderPanier" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 5; -fx-cursor: hand;" text="🗑️ Vider le panier">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button fx:id="validerCommandeBtn" onAction="#handleValiderCommande" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 5; -fx-cursor: hand;" text="✅ Valider la commande">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <!-- Message d'information -->
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Les prix sont garantis au moment de l'ajout au panier" />
            </children>
        </VBox>
    </children>
</VBox>