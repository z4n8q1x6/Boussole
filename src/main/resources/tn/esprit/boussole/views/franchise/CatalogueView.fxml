<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #0B0F1A;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.franchise.CatalogueController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <!-- En-tête avec titre et recherche -->
        <VBox spacing="15.0">
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="🛒 Marketplace" />

                <!-- Barre de recherche et filtres -->
                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <children>
                        <HBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <TextField fx:id="searchField" promptText="Rechercher un produit..." style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-prompt-text-fill: #64748B; -fx-border-color: #334155; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" HBox.hgrow="ALWAYS" />
                                <Button style="-fx-background-color: #0EA5E9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;" text="🔍 Rechercher" />
                            </children>
                        </HBox>

                        <Label style="-fx-text-fill: #94A3B8;" text="Trier par:" />
                        <ComboBox fx:id="sortCombo" prefWidth="150" style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-border-color: #334155;" />

                        <Button onAction="#handleRefresh" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;" text="🔄 Rafraîchir" />
                    </children>
                </HBox>

                <!-- Résultat de recherche -->
                <Label fx:id="resultCountLabel" style="-fx-text-fill: #94A3B8;" text="0 produit(s) trouvé(s)" />
            </children>
        </VBox>

        <!-- Catalogue en grille (scrollable) -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <GridPane fx:id="catalogueGrid" hgap="20" vgap="20" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                    </columnConstraints>
                </GridPane>
            </content>
        </ScrollPane>

        <!-- Bouton supprimé : on retire le HBox avec le bouton flottant -->
    </children>
</VBox>