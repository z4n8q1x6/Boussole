<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.LigneCommandeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <!-- Barre d'outils -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label styleClass="title-label" text="📝 Gestion des Lignes de Commande" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="action-button" text="🔄 Rafraîchir" />
            </children>
        </HBox>

        <!-- Tableau des lignes de commande -->
        <TableView fx:id="ligneTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colQuantite" prefWidth="80.0" text="Quantité" />
                <TableColumn fx:id="colPrix" prefWidth="100.0" text="Prix unitaire" />
                <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total" />
                <TableColumn fx:id="colCommandeId" prefWidth="100.0" text="Commande ID" />
                <TableColumn fx:id="colProduit" prefWidth="150.0" text="Produit" />
                <TableColumn fx:id="colActions" prefWidth="100.0" text="Actions" />
            </columns>
        </TableView>

        <!-- Formulaire -->
        <VBox styleClass="form-panel">
            <children>
                <Label styleClass="form-title" text="AJOUTER / MODIFIER UNE LIGNE DE COMMANDE" />

                <GridPane hgap="20.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="100.0" />
                        <ColumnConstraints minWidth="250.0" />
                        <ColumnConstraints halignment="RIGHT" minWidth="100.0" />
                        <ColumnConstraints minWidth="250.0" />
                    </columnConstraints>

                    <children>
                        <Label styleClass="form-label" text="Commande:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <ComboBox fx:id="commandeCombo" promptText="Sélectionner une commande" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <Label styleClass="form-label" text="Produit:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                        <ComboBox fx:id="produitCombo" promptText="Sélectionner un produit" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                        <Label styleClass="form-label" text="Quantité:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <TextField fx:id="quantiteField" promptText="Quantité" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                        <Label styleClass="form-label" text="Prix unitaire:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                        <TextField fx:id="prixUnitaireField" promptText="Prix unitaire" editable="false" GridPane.rowIndex="1" GridPane.columnIndex="3" />
                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleAjouter" styleClass="action-button" text="➕ Ajouter" />
                        <Button mnemonicParsing="false" onAction="#handleModifier" styleClass="edit-button" text="✏️ Modifier" />
                        <Button mnemonicParsing="false" onAction="#handleSupprimer" styleClass="delete-button" text="🗑️ Supprimer" />
                        <Button mnemonicParsing="false" onAction="#handleEffacer" styleClass="clear-button" text="🗑️ Effacer" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>