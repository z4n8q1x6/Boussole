<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.MainController">

    <!-- Barre latérale gauche - largeur augmentée -->
    <left>
        <VBox fx:id="navigationPanel" styleClass="nav-panel" prefWidth="250" spacing="5">
            <padding>
                <Insets top="20" bottom="20" />
            </padding>

            <children>
                <!-- Logo -->
                <Label styleClass="logo" text="BOUSSOLE" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="20" bottom="20" />
                    </padding>
                </Label>

                <Separator style="-fx-background-color: #34495e;" />

                <!-- Section principale -->
                <Label styleClass="nav-header" text="PRINCIPAL" />
                <Button fx:id="btnDashboard" styleClass="nav-button" text="🏠  Tableau de bord" onAction="#showDashboard" maxWidth="Infinity" />
                <Button fx:id="btnProduit" styleClass="nav-button" text="📦  Produit" onAction="#showProduits" maxWidth="Infinity" />
                <Button fx:id="btnCommande" styleClass="nav-button" text="📋  Commande" onAction="#showCommandes" maxWidth="Infinity" />
                <Button fx:id="btnLigneCommande" styleClass="nav-button" text="📝  Ligne commande" onAction="#showLignesCommande" maxWidth="Infinity" />

                <Separator style="-fx-background-color: #34495e;" />

                <!-- Section Gestion -->
                <Label styleClass="nav-header" text="GESTION" />
                <Button fx:id="btnFournisseur" styleClass="nav-button" text="🚚  Fournisseur" disable="true" maxWidth="Infinity" />
                <Button fx:id="btnFranchises" styleClass="nav-button" text="🏢  Franchises" disable="true" maxWidth="Infinity" />
                <Button fx:id="btnAlerteias" styleClass="nav-button" text="⚠️  Alerteias" disable="true" maxWidth="Infinity" />
                <Button fx:id="btnReclamations" styleClass="nav-button" text="📢  Réclamations" disable="true" maxWidth="Infinity" />

                <Separator style="-fx-background-color: #34495e;" />

                <!-- Section Finances -->
                <Label styleClass="nav-header" text="FINANCES" />
                <Button fx:id="btnBilan" styleClass="nav-button" text="📊  Bilan" disable="true" maxWidth="Infinity" />
                <Button fx:id="btnBudget" styleClass="nav-button" text="💰  Budget prévisionnel" disable="true" maxWidth="Infinity" />
                <Button fx:id="btnCharge" styleClass="nav-button" text="💸  Charge" disable="true" maxWidth="Infinity" />
                <Button fx:id="btnMensualite" styleClass="nav-button" text="📅  Mensualité" disable="true" maxWidth="Infinity" />
                <Button fx:id="btnPret" styleClass="nav-button" text="🏦  Prêt" disable="true" maxWidth="Infinity" />
                <Button fx:id="btnTransaction" styleClass="nav-button" text="💳  Transaction" disable="true" maxWidth="Infinity" />

                <Separator style="-fx-background-color: #34495e;" />

                <!-- Section Administration -->
                <Label styleClass="nav-header" text="ADMINISTRATION" />
                <Button fx:id="btnUtilisateur" styleClass="nav-button" text="👤  Utilisateur" disable="true" maxWidth="Infinity" />

                <!-- Espace flexible -->
                <Region VBox.vgrow="ALWAYS" />

                <!-- Version -->
                <Label styleClass="version-label" text="Version 1.0.0">
                    <padding>
                        <Insets left="20" top="10" bottom="10" />
                    </padding>
                </Label>
            </children>
        </VBox>
    </left>

    <!-- Zone de contenu central -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" />
    </center>

</BorderPane>