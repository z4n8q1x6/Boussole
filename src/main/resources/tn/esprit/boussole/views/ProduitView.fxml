<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.ProduitController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <children>
        <!-- Barre d'outils -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label styleClass="title-label" text="📦 Gestion des Produits" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="action-button" text="Rafraîchir" />
            </children>
        </HBox>

        <!-- Tableau des produits -->
        <TableView fx:id="produitTable" prefHeight="250" editable="true">
            <columns>
                <TableColumn fx:id="colNom" prefWidth="150" text="Nom" />
                <TableColumn fx:id="colReference" prefWidth="120" text="Référence" />
                <TableColumn fx:id="colPrix" prefWidth="100" text="Prix (DT)" />
                <TableColumn fx:id="colStock" prefWidth="80" text="Stock" />
                <TableColumn fx:id="colImage" prefWidth="100" text="Image" />
                <TableColumn fx:id="colActions" prefWidth="100" text="Actions" editable="false" />
            </columns>
        </TableView>

        <!-- Formulaire avec aperçu image -->
        <VBox styleClass="form-panel">
            <children>
                <Label styleClass="form-title" text="AJOUTER UN PRODUIT" />

                <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="80" />
                        <ColumnConstraints minWidth="200" />
                        <ColumnConstraints halignment="RIGHT" minWidth="80" />
                        <ColumnConstraints minWidth="200" />
                    </columnConstraints>

                    <children>
                        <Label styleClass="form-label" text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <TextField fx:id="nomField" promptText="Nom du produit" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <Label styleClass="form-label" text="Référence:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                        <TextField fx:id="referenceField" promptText="Référence" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                        <Label styleClass="form-label" text="Prix:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <TextField fx:id="prixField" promptText="0.00" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                        <Label styleClass="form-label" text="Stock:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                        <TextField fx:id="stockField" promptText="0" GridPane.rowIndex="1" GridPane.columnIndex="3" />

                        <Label styleClass="form-label" text="Image:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <HBox spacing="5" GridPane.columnSpan="3" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <TextField fx:id="imageField" promptText="Chemin de l'image" HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnParcourir" onAction="#handleParcourirImage" text="📁 Parcourir" styleClass="action-button" />
                        </HBox>

                        <Label styleClass="form-label" text="Aperçu:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                        <ImageView fx:id="apercuImage" fitHeight="80" fitWidth="80" preserveRatio="true" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleAjouter" styleClass="action-button" text="➕ Ajouter" />
                        <Button mnemonicParsing="false" onAction="#handleEffacer" styleClass="clear-button" text="🗑️ Effacer" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>