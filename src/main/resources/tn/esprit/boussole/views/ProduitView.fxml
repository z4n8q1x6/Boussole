<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.ProduitController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <!-- Barre d'outils -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label styleClass="title-label" text="📦 Gestion des Produits" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="action-button" text="🔄 Rafraîchir" />
            </children>
        </HBox>

        <!-- Tableau des produits -->
        <TableView fx:id="produitTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNom" prefWidth="150.0" text="Nom" />
                <TableColumn fx:id="colReference" prefWidth="120.0" text="Référence" />
                <TableColumn fx:id="colPrix" prefWidth="100.0" text="Prix (DT)" />
                <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
                <TableColumn fx:id="colImage" prefWidth="150.0" text="Image" />
                <TableColumn fx:id="colActions" prefWidth="100.0" text="Actions" />
            </columns>
        </TableView>

        <!-- Formulaire -->
        <VBox styleClass="form-panel">
            <children>
                <Label styleClass="form-title" text="AJOUTER / MODIFIER UN PRODUIT" />

                <GridPane hgap="20.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="80.0" />
                        <ColumnConstraints minWidth="200.0" />
                        <ColumnConstraints halignment="RIGHT" minWidth="80.0" />
                        <ColumnConstraints minWidth="200.0" />
                    </columnConstraints>

                    <children>
                        <Label styleClass="form-label" text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <TextField fx:id="nomField" promptText="Nom du produit" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <Label styleClass="form-label" text="Référence:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                        <TextField fx:id="referenceField" promptText="Référence" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                        <Label styleClass="form-label" text="Prix (DT):" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <TextField fx:id="prixField" promptText="0.00" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                        <Label styleClass="form-label" text="Stock:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                        <TextField fx:id="stockField" promptText="0" GridPane.rowIndex="1" GridPane.columnIndex="3" />

                        <Label styleClass="form-label" text="Image URL:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <TextField fx:id="imageField" promptText="URL de l'image" GridPane.columnSpan="3" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnSpan="4">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleAjouter" styleClass="action-button" text="➕ Ajouter" />
                        <Button mnemonicParsing="false" onAction="#handleModifier" styleClass="edit-button" text="✏️ Modifier" />
                        <Button mnemonicParsing="false" onAction="#handleSupprimer" styleClass="delete-button" text="🗑️ Supprimer" />
                        <Button mnemonicParsing="false" onAction="#handleEffacer" styleClass="clear-button" text="🗑️ Effacer" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>