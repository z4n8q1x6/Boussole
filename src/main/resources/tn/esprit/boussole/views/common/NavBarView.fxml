<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1400.0" style="-fx-background-color: #0B0F1A;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.common.NavbarController">
    <children>
        <!-- ===================== SIDEBAR ===================== -->
        <VBox prefWidth="260" style="-fx-background-color: linear-gradient(to bottom, #0F172A, #020617);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- En-tête du menu avec logo -->
                <VBox alignment="CENTER" prefHeight="120.0" spacing="10.0">
                    <children>
                        <!-- Logo image -->
                        <ImageView fitHeight="50.0" fitWidth="50.0" preserveRatio="true">
                            <Image url="@/images/logo.png" />
                        </ImageView>
                        <Label text="Boussole" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblPanelType" text="PANEL ENTREPRISE" textFill="#64748B" style="-fx-font-weight: bold;"/>
                    </children>
                </VBox>

                <!-- Boutons du menu avec images -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="menuContainer" spacing="10.0" style="-fx-background-color: transparent;">
                            <padding>
                                <Insets left="20.0" right="20.0" />
                            </padding>

                            <!-- Les boutons seront ajoutés dynamiquement par le contrôleur -->
                            <!-- Mais voici la structure avec images pour référence -->

                            <!-- Exemple pour dashboard (avec image) -->
                            <!--
                            <Button styleClass="menu-button" prefHeight="45.0" prefWidth="220.0">
                                <graphic>
                                    <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                        <Image url="@/images/dashboard.png" />
                                    </ImageView>
                                </graphic>
                                <text>  Tableau de bord</text>
                            </Button>
                            -->

                            <!-- Exemple pour produits (avec image) -->
                            <!--
                            <Button styleClass="menu-button" prefHeight="45.0" prefWidth="220.0">
                                <graphic>
                                    <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                        <Image url="@/images/products.png" />
                                    </ImageView>
                                </graphic>
                                <text>  Produit</text>
                            </Button>
                            -->

                            <!-- Exemple pour commandes (avec image) -->
                            <!--
                            <Button styleClass="menu-button" prefHeight="45.0" prefWidth="220.0">
                                <graphic>
                                    <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                        <Image url="@/images/orders.png" />
                                    </ImageView>
                                </graphic>
                                <text>  Commande</text>
                            </Button>
                            -->
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- Bouton déconnexion avec image -->
                <Button fx:id="btnLogout" alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="50.0" prefWidth="260.0" style="-fx-background-color: transparent; -fx-text-fill: #EF4444; -fx-font-weight: bold;">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@/images/logout.png" />
                        </ImageView>
                    </graphic>
                    <text>  Déconnexion</text>
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                </Button>
            </children>
        </VBox>

        <!-- ===================== MAIN CONTENT ===================== -->
        <VBox layoutX="260.0" spacing="25.0" style="-fx-background-color: #0B0F1A;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="260.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <!-- Header avec utilisateur -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label fx:id="lblPageTitle" text="Tableau de bord" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill:white;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <!-- Avatar utilisateur -->
                                <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
                                    <Image url="@/images/user.png" />
                                </ImageView>
                                <Label fx:id="lblUsername" text="Utilisateur" textFill="#94A3B8">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Zone de contenu dynamique -->
                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </children>

    <stylesheets>
        <URL value="@/tn/esprit/boussole/styles/dash.css" />
    </stylesheets>
</AnchorPane>