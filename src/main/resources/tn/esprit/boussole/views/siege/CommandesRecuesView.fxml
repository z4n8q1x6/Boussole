<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #0B0F1A;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.siege.CommandesRecuesController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <!-- En-tête -->
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="📋 Commandes reçues" />

        <!-- Statistiques -->
        <HBox spacing="20.0">
            <children>
                <VBox style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="140">
                    <children>
                        <Label style="-fx-text-fill: #94A3B8;" text="Total" />
                        <Label fx:id="totalCommandesLabel" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
                    </children>
                </VBox>

                <VBox style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="140">
                    <children>
                        <Label style="-fx-text-fill: #94A3B8;" text="En attente" />
                        <Label fx:id="totalAttenteLabel" style="-fx-text-fill: #F59E0B; -fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
                    </children>
                </VBox>

                <VBox style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="140">
                    <children>
                        <Label style="-fx-text-fill: #94A3B8;" text="Validées" />
                        <Label fx:id="totalValideesLabel" style="-fx-text-fill: #10B981; -fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
                    </children>
                </VBox>

                <VBox style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="140">
                    <children>
                        <Label style="-fx-text-fill: #94A3B8;" text="Refusées" />
                        <Label fx:id="totalRefuseesLabel" style="-fx-text-fill: #EF4444; -fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
                    </children>
                </VBox>

                <VBox style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="180">
                    <children>
                        <Label style="-fx-text-fill: #94A3B8;" text="Chiffre d'affaires" />
                        <Label fx:id="chiffreAffairesLabel" style="-fx-text-fill: #0EA5E9; -fx-font-size: 24px; -fx-font-weight: bold;" text="0 DT" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Filtres -->
        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <children>
                <Label style="-fx-text-fill: #94A3B8;" text="Filtrer par statut:" />
                <ComboBox fx:id="filtreStatutCombo" prefWidth="150" style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-border-color: #334155;" />

                <Button onAction="#handleRefresh" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;" text="🔄 Rafraîchir" />

                <Button onAction="#handleEnAttente" style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;" text="⏳ En attente" />
            </children>
        </HBox>

        <!-- Tableau des commandes -->
        <TableView fx:id="commandeTable" style="-fx-background-color: transparent; -fx-border-color: #334155; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFranchise" prefWidth="180" text="Franchise" />
                <TableColumn fx:id="colDate" prefWidth="160" text="Date" />
                <TableColumn fx:id="colTotal" prefWidth="120" text="Total" />
                <TableColumn fx:id="colStatut" prefWidth="120" text="Statut" />
                <TableColumn fx:id="colActions" prefWidth="200" text="Actions" />
            </columns>
        </TableView>
    </children>
</VBox>