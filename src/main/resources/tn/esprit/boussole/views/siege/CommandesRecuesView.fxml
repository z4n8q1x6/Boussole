<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="content-area" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.siege.CommandesRecuesController">
    <padding>
        <Insets bottom="25" left="25" right="25" top="25"/>
    </padding>

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
            <Image url="@/images/orders.png" />
        </ImageView>
        <Label styleClass="page-title" text="Commandes reçues" />
    </HBox>

    <!-- Statistiques - SANS wrapWidth -->
    <HBox spacing="15">
        <VBox styleClass="stat-card">
            <Label styleClass="stat-label" text="TOTAL" />
            <Label fx:id="totalCommandesLabel" styleClass="stat-value" text="0" />
        </VBox>
        <VBox styleClass="stat-card">
            <Label styleClass="stat-label" text="EN ATTENTE" />
            <Label fx:id="totalAttenteLabel" styleClass="stat-value" text="0" style="-fx-text-fill: #F59E0B;" />
        </VBox>
        <VBox styleClass="stat-card">
            <Label styleClass="stat-label" text="VALIDÉES" />
            <Label fx:id="totalValideesLabel" styleClass="stat-value" text="0" style="-fx-text-fill: #10B981;" />
        </VBox>
        <VBox styleClass="stat-card">
            <Label styleClass="stat-label" text="REFUSÉES" />
            <Label fx:id="totalRefuseesLabel" styleClass="stat-value" text="0" style="-fx-text-fill: #EF4444;" />
        </VBox>
        <VBox styleClass="stat-card">
            <Label styleClass="stat-label" text="CHIFFRE AFFAIRES" />
            <Label fx:id="chiffreAffairesLabel" styleClass="stat-value" text="0 DT" />
        </VBox>
    </HBox>

    <!-- Filtres -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Filtrer par statut:" style="-fx-text-fill: #94A3B8;" />
        <ComboBox fx:id="filtreStatutCombo" prefWidth="200" prefHeight="35"
                  style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;" />
        <Button onAction="#handleRefresh" styleClass="action-button" text="Rafraîchir" />
        <Button onAction="#handleEnAttente" styleClass="edit-button" text="En attente" />
    </HBox>

    <!-- Tableau des commandes -->
    <TableView fx:id="commandeTable" VBox.vgrow="ALWAYS" prefHeight="450">
        <columns>
            <TableColumn fx:id="colFranchise" prefWidth="200" text="FRANCHISE" />
            <TableColumn fx:id="colDate" prefWidth="180" text="DATE" />
            <TableColumn fx:id="colTotal" prefWidth="140" text="TOTAL" />
            <TableColumn fx:id="colStatut" prefWidth="140" text="STATUT" />
            <TableColumn fx:id="colActions" prefWidth="240" text="ACTIONS" />
        </columns>
    </TableView>
</VBox>