<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.siege.SiegeMainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <!-- En-tête -->
        <Label text="Espace Administration Siège" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />

        <!-- Statistiques -->
        <HBox spacing="20.0">
            <children>
                <!-- Carte Produits -->
                <VBox style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 20; -fx-min-width: 180;">
                    <children>
                        <Label text="📦" style="-fx-font-size: 30px;" />
                        <Label text="Produits" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;" />
                        <Label fx:id="produitsLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                    </children>
                </VBox>

                <!-- Carte Commandes -->
                <VBox style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 20; -fx-min-width: 180;">
                    <children>
                        <Label text="📋" style="-fx-font-size: 30px;" />
                        <Label text="Commandes" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;" />
                        <Label fx:id="commandesLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                    </children>
                </VBox>

                <!-- Carte En attente -->
                <VBox style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 20; -fx-min-width: 180;">
                    <children>
                        <Label text="⏳" style="-fx-font-size: 30px;" />
                        <Label text="En attente" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;" />
                        <Label fx:id="enAttenteLabel" text="0" style="-fx-text-fill: #F59E0B; -fx-font-size: 24px; -fx-font-weight: bold;" />
                    </children>
                </VBox>

                <!-- Carte Franchises -->
                <VBox style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 20; -fx-min-width: 180;">
                    <children>
                        <Label text="🏢" style="-fx-font-size: 30px;" />
                        <Label text="Franchises" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;" />
                        <Label fx:id="franchisesLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                    </children>
                </VBox>

                <!-- Carte Chiffre d'affaires -->
                <VBox style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 20; -fx-min-width: 200;">
                    <children>
                        <Label text="💰" style="-fx-font-size: 30px;" />
                        <Label text="Chiffre d'affaires" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;" />
                        <Label fx:id="chiffreAffairesLabel" text="0 DT" style="-fx-text-fill: #0EA5E9; -fx-font-size: 24px; -fx-font-weight: bold;" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Message -->
        <Label text="Gérez votre catalogue et les commandes" style="-fx-text-fill: #64748B;" />
    </children>
</VBox>