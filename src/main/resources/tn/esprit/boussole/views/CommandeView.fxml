<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.boussole.gui.CommandeController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <children>
        <!-- Barre d'outils -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label styleClass="title-label" text="📋 Gestion des Commandes" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="action-button" text="Rafraîchir" />
            </children>
        </HBox>

        <!-- Tableau des commandes -->
        <TableView fx:id="commandeTable" prefHeight="300" editable="true">
            <columns>
                <TableColumn fx:id="colDate" prefWidth="180" text="Date création" editable="false" />
                <TableColumn fx:id="colMontant" prefWidth="150" text="Montant (DT)" />
                <TableColumn fx:id="colStatut" prefWidth="150" text="Statut" />
                <TableColumn fx:id="colFranchiseId" prefWidth="120" text="Franchise ID" />
                <TableColumn fx:id="colActions" prefWidth="120" text="Actions" editable="false" />
            </columns>
        </TableView>

        <!-- Formulaire (pour AJOUT uniquement) -->
        <VBox styleClass="form-panel">
            <children>
                <Label styleClass="form-title" text="AJOUTER UNE COMMANDE" />

                <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="80" />
                        <ColumnConstraints minWidth="200" />
                        <ColumnConstraints halignment="RIGHT" minWidth="80" />
                        <ColumnConstraints minWidth="200" />
                    </columnConstraints>

                    <children>
                        <Label styleClass="form-label" text="Montant:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <TextField fx:id="montantField" promptText="0.00" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <Label styleClass="form-label" text="Statut:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                        <ComboBox fx:id="statutCombo" promptText="Sélectionner" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                        <Label styleClass="form-label" text="Franchise ID:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <TextField fx:id="franchiseIdField" promptText="ID franchise" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleAjouter" styleClass="action-button" text="➕ Ajouter" />
                        <Button mnemonicParsing="false" onAction="#handleEffacer" styleClass="clear-button" text="🗑️ Effacer" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>