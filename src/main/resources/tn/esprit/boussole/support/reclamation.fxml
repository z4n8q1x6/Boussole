<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="18"
  style="-fx-background-color: #06080F;"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="tn.esprit.boussole.gui.ReclamationController"
  stylesheets="/tn/esprit/boussole/support/css/dark-table.css">

  <padding>
    <Insets top="25" right="25" bottom="25" left="25" />
  </padding>

  <!-- Header with title and button -->
  <HBox spacing="10" alignment="CENTER_LEFT">

    <VBox spacing="4" HBox.hgrow="ALWAYS">

      <Label text="Réclamations"
        textFill="#E8EDF5">
        <font>
          <Font name="System Bold" size="22" />
        </font>
      </Label>

      <Label text="Gérez et suivez les réclamations"
        textFill="#8e9aaf" />

    </VBox>

    <Button onAction="#delete"
      maxWidth="1.7976931348623157E308"
      prefHeight="40"
      prefWidth="140"
      text="Supprimer"
      style="-fx-background-color: #3D1A1A;
                 -fx-text-fill: #F43F5E;
                 -fx-font-weight: bold;
                 -fx-padding: 12 20;
                 -fx-background-radius: 8;
                 -fx-cursor: hand;
                 -fx-border-color: rgba(244,63,94,0.3);
                 -fx-border-radius: 8;" />

    <Button fx:id="btnAdd"
      text="+ Réclamation"
      onAction="#handleAddReclamation"
      prefHeight="40"
      prefWidth="140"
      style="
                    -fx-background-color: #00E5CC;
                    -fx-text-fill: #06080F;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                    -fx-padding: 0 18;
                    -fx-cursor: hand;
                " />

  </HBox>


  <!-- Card container -->
  <VBox spacing="10"
    style="
              -fx-background-color: #0C0F1A;
              -fx-background-radius: 12;
              -fx-border-color: rgba(255,255,255,0.06);
              -fx-border-radius: 12;
              -fx-padding: 15;
          "
    VBox.vgrow="ALWAYS">

    <TableView fx:id="table"
      VBox.vgrow="ALWAYS"
      style="
               -fx-background-color: transparent;
               -fx-control-inner-background: #0C0F1A;
               -fx-table-cell-border-color: rgba(255,255,255,0.05);
               -fx-selection-bar: #00E5CC33;
               -fx-selection-bar-non-focused: #00E5CC22;
           ">

      <columns>

        <TableColumn fx:id="colSujet"
          text="Sujet"
          style="-fx-text-fill: #E8EDF5;" />

        <TableColumn fx:id="colDescription"
          text="Description"
          style="-fx-text-fill: #E8EDF5;" />

        <TableColumn fx:id="colStatut"
          text="Statut"
          style="-fx-text-fill: #E8EDF5;" />

        <TableColumn fx:id="colDate"
          text="Date"
          style="-fx-text-fill: #E8EDF5;" />

      </columns>

      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>

    </TableView>

  </VBox>


</VBox>
