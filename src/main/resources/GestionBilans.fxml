<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.boussole.gui.GestionBilansController"
            fx:id="contentPane"
            stylesheets="@styles.css"
            style="-fx-background-color: #07090F;">
    <center>
        <VBox spacing="22" style="-fx-background-color: #07090F;">
            <padding><Insets top="28" right="44" bottom="28" left="44"/></padding>

            <!-- ═══ HEADER ═══ -->
            <VBox spacing="4">
                <Label text="Reporting Financier"
                       style="-fx-font-size: 30px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                <Label text="Génération et export des bilans mensuels"
                       style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
            </VBox>

            <!-- ═══ CARTE PRINCIPALE ═══ -->
            <VBox VBox.vgrow="ALWAYS" spacing="18"
                  style="-fx-background-color: #0D1117;
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.06);
                         -fx-border-radius: 18; -fx-border-width: 1;
                         -fx-padding: 28;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),16,0,0,4);">

                <!-- Ligne 1 : Filtres -->
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="Cible :"
                           style="-fx-text-fill: #8892A4; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cbFranchiseCible" promptText="TOUT LE RÉSEAU" prefWidth="200"
                              style="-fx-background-color: #161B2E; -fx-text-fill: white;
                                     -fx-border-color: rgba(255,255,255,0.12);
                                     -fx-border-radius: 10; -fx-background-radius: 10;"/>

                    <Label text="Période :"
                           style="-fx-text-fill: #8892A4; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="comboMois" promptText="Mois" prefWidth="140"
                              style="-fx-background-color: #161B2E; -fx-text-fill: white;
                                     -fx-border-color: rgba(255,255,255,0.12);
                                     -fx-border-radius: 10; -fx-background-radius: 10;"/>
                    <ComboBox fx:id="comboAnnee" promptText="Année" prefWidth="100"
                              style="-fx-background-color: #161B2E; -fx-text-fill: white;
                                     -fx-border-color: rgba(255,255,255,0.12);
                                     -fx-border-radius: 10; -fx-background-radius: 10;"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnGenererBilan" text="✦ Générer / Recalculer"
                            style="-fx-background-color: #00F5D4;
                                   -fx-text-fill: #030D0B;
                                   -fx-font-weight: 900; -fx-font-size: 12px;
                                   -fx-background-radius: 30; -fx-cursor: hand;
                                   -fx-padding: 8 18 8 18;
                                   -fx-effect: dropshadow(gaussian,rgba(0,245,212,0.45),18,0.2,0,0);"/>
                </HBox>

                <!-- Ligne 2 : Actions -->
                <HBox spacing="14" alignment="CENTER_RIGHT">
                    <Button fx:id="btnExporterPDF" text="⬇ Exporter PDF"
                            style="-fx-background-color: #0A84FF;
                                   -fx-text-fill: #000000;
                                   -fx-font-weight: 800; -fx-font-size: 12px;
                                   -fx-background-radius: 30; -fx-cursor: hand;
                                   -fx-padding: 8 18 8 18;
                                   -fx-effect: dropshadow(gaussian,rgba(10,132,255,0.45),18,0.2,0,0);"/>
                    <Button fx:id="btnEnvoyerEmail" text="✉ Envoyer Bilan par Email"
                            style="-fx-background-color: #00C896;
                                   -fx-text-fill: #000000;
                                   -fx-font-weight: 800; -fx-font-size: 12px;
                                   -fx-background-radius: 30; -fx-cursor: hand;
                                   -fx-padding: 8 18 8 18;
                                   -fx-effect: dropshadow(gaussian,rgba(0,200,150,0.45),18,0.2,0,0);"/>
                    <Label text="↑ Sélectionnez une ligne puis cliquez"
                           style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-style: italic;"/>
                </HBox>

                <!-- Titre tableau -->
                <Label text="Historique des Bilans"
                       style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #8892A4;"/>

                <!-- ═══ TABLEAU ═══ -->
                <TableView fx:id="tableBilans" VBox.vgrow="ALWAYS"
                           styleClass="bilan-table-view"
                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                    <columns>
                        <TableColumn fx:id="colFranchise" text="FRANCHISE"      prefWidth="140" minWidth="100"/>
                        <TableColumn fx:id="colMois"      text="MOIS"           prefWidth="55"  minWidth="45"/>
                        <TableColumn fx:id="colAnnee"     text="ANNÉE"          prefWidth="60"  minWidth="50"/>
                        <TableColumn fx:id="colRecettes"  text="RECETTES (TND)" prefWidth="130" minWidth="100"/>
                        <TableColumn fx:id="colCharges"   text="CHARGES (TND)"  prefWidth="130" minWidth="100"/>
                        <TableColumn fx:id="colResultat"  text="RÉSULTAT NET"   prefWidth="120" minWidth="90"/>
                        <TableColumn fx:id="colStatut"    text="RENTABILITÉ"    prefWidth="120" minWidth="90"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Aucun bilan généré"
                               style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>
                    </placeholder>
                </TableView>

            </VBox>
        </VBox>
    </center>
</BorderPane>