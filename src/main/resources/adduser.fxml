<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainAnchorPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="700.0" prefWidth="550.0"
            style="-fx-background-color: #06080F; -fx-background-radius: 15; -fx-border-color: rgba(0, 229, 204, 0.3); -fx-border-radius: 15; -fx-border-width: 1;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.boussole.gui.addUserController">
    <children>
        <VBox layoutX="40.0" layoutY="30.0" spacing="5.0" AnchorPane.leftAnchor="40.0" AnchorPane.topAnchor="30.0">
            <children>
                <Label text="Nouvelle Entreprise" textFill="#E8EDF5">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Label>
                <Label text="Complétez les informations pour créer le compte" textFill="#8892A4">
                    <font><Font size="13.0" /></font>
                </Label>
            </children>
        </VBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutY="110.0" prefHeight="590.0" prefWidth="550.0"
                    style="-fx-background-color: transparent; -fx-background: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="110.0">
            <content>
                <VBox spacing="20.0">
                    <padding><Insets bottom="40.0" left="40.0" right="40.0" top="10.0" /></padding>
                    <children>

                        <Label text="RESPONSABLE DU COMPTE" textFill="#00E5CC">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>

                        <HBox spacing="15.0" alignment="BOTTOM_LEFT">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="Nom" textFill="#8892A4" />
                                    <TextField fx:id="txtNom" promptText="Ex: Ben Ahmed" style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10;" />
                                </VBox>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="Prénom" textFill="#8892A4" />
                                    <TextField fx:id="txtPrenom" promptText="Ex: Mohamed" style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10;" />
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Bouton Photo -->
                        <Button fx:id="btnPhoto" onAction="#handleCapturePhoto" text="📷 Ajouter une photo (Face ID)"
                                maxWidth="Infinity" style="-fx-background-color: #1E293B; -fx-text-fill: #00E5CC; -fx-border-color: #00E5CC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>

                        <VBox spacing="8.0">
                            <Label text="Email" textFill="#8892A4" />
                            <TextField fx:id="txtEmail" promptText="m.ahmed@entreprise.tn" style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10;" />
                        </VBox>

                        <VBox spacing="8.0">
                            <Label text="Mot de passe" textFill="#8892A4" />
                            <Label text="Un mot de passe sécurisé sera généré et envoyé par email." textFill="#3A4258" style="-fx-font-style: italic;" />
                        </VBox>

                        <Separator opacity="0.1" />

                        <Label text="DÉTAILS DE L'ENTREPRISE" textFill="#00E5CC">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>

                        <VBox spacing="8.0">
                            <Label text="Nom de l'entreprise" textFill="#8892A4" />
                            <TextField fx:id="txtNomEntreprise" style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10;" />
                        </VBox>

                        <HBox spacing="15.0">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="Téléphone" textFill="#8892A4" />
                                    <TextField fx:id="txtTelephone" style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10;" />
                                </VBox>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="Solde initial (DT)" textFill="#8892A4" />
                                    <TextField fx:id="txtSolde" style="-fx-background-color: #0C0F1A; -fx-text-fill: #00E5CC; -fx-border-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10; -fx-font-weight: bold;" text="0.00" />
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="8.0">
                            <Label text="Adresse" textFill="#8892A4" />
                            <TextField fx:id="txtAdresseEntreprise" style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10;" />
                        </VBox>

                        <CheckBox fx:id="checkActif" selected="true" style="-fx-text-fill: #E8EDF5;" text="Activer le compte immédiatement" />

                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Button onAction="#handleCancel" prefHeight="40.0" prefWidth="100.0"
                                        style="-fx-background-color: transparent; -fx-text-fill: #8892A4; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;" text="Annuler" />
                                <Button fx:id="btnCreate" onAction="#handleCreate" prefHeight="40.0" prefWidth="180.0"
                                        style="-fx-background-color: #00E5CC; -fx-text-fill: #06080F; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text="CRÉER" />
                            </children>
                            <VBox.margin><Insets top="10.0" /></VBox.margin>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>