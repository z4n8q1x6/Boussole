<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="950.0" spacing="25.0" style="-fx-background-color: #06080F;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.chargesdepenses.gui.afficherBackFournisseurController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Gestion des Fournisseurs" textFill="#E8EDF5">
                <font><Font name="System Bold" size="26.0" /></font>
            </Label>
            <Label text="Visualisation et gestion des partenaires enregistrés" textFill="#8892A4">
                <font><Font size="13.0" /></font>
            </Label>
        </VBox>
        <HBox spacing="10">
            <Button fx:id="btnFront" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-cursor: hand;" text="Vue Front" />
            <Button fx:id="btnAjouter" style="-fx-background-color: #0EA5E9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20; -fx-cursor: hand;" text="+ Ajouter" />
        </HBox>
    </HBox>

    <HBox spacing="15.0">
        <TextField fx:id="txtRecherche" prefHeight="42.0" prefWidth="380.0" promptText="🔍 Rechercher un fournisseur (nom...)" style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 15 0 15;" />
        <ComboBox fx:id="comboTri" prefHeight="42.0" promptText="Trier par" style="-fx-background-color: #0C0F1A; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10;" />
    </HBox>

    <TableView fx:id="tableFournisseurs" styleClass="dark-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNom" prefWidth="169.60000836849213" text="NOM" />
            <TableColumn fx:id="colMatricule" prefWidth="190.40000915527344" text="MATRICULE" />
            <TableColumn fx:id="colTelephone" prefWidth="120.0" text="TÉLÉPHONE" />
            <TableColumn fx:id="colFranchiseId" prefWidth="196.0" text="NOM FRANCHISE" />
            <TableColumn fx:id="colModifier" maxWidth="124.800048828125" minWidth="54.4000244140625" prefWidth="93.5999755859375" text="MOD" />
            <TableColumn fx:id="colSupprimer" maxWidth="95.199951171875" minWidth="60.0" prefWidth="73.5999755859375" text="SUPP" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="lblTotal" text="Total : 0" textFill="#E8EDF5">
            <font><Font name="System Bold" size="14.0" /></font>
        </Label>
    </HBox>
</VBox>
