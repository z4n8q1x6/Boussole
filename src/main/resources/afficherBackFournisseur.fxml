<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="950.0" spacing="25.0"
  style="-fx-background-color: #06080F;"
  stylesheets="@styles/ChargesdepensesDash.css"
  xmlns="http://javafx.com/javafx/17"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="tn.esprit.boussole.gui.afficherBackFournisseurController">

  <padding>
    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
  </padding>

  <HBox alignment="CENTER_LEFT">
    <VBox HBox.hgrow="ALWAYS">
      <Label text="Gestion des Fournisseurs" textFill="#E8EDF5">
        <font>
          <Font name="System Bold" size="26.0" />
        </font>
      </Label>
      <Label text="Visualisation et gestion des partenaires enregistrés" textFill="#8892A4">
        <font>
          <Font size="13.0" />
        </font>
      </Label>
    </VBox>

    <HBox spacing="10">
      <Button fx:id="btnAjouter" text="+ Ajouter"
        prefHeight="40"
        prefWidth="140"
        style="
                    -fx-background-color: #00E5CC;
                    -fx-text-fill: #06080F;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                    -fx-padding: 0 18;
                    -fx-cursor: hand;"
      />
    </HBox>
  </HBox>

  <HBox spacing="15.0">
    <TextField fx:id="txtRecherche" prefHeight="42.0" prefWidth="380.0"
      promptText="🔍 Rechercher un fournisseur (nom...)"
      style="-fx-background-color: #0C0F1A; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 15 0 15;" />
    <ComboBox fx:id="comboTri" prefHeight="42.0" promptText="Trier par"
      style="-fx-background-color: #0C0F1A; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10; -fx-background-radius: 10;" />
  </HBox>

  <TableView fx:id="tableFournisseurs" VBox.vgrow="ALWAYS">
    <columns>
      <TableColumn fx:id="colNom" prefWidth="150.0" text="NOM" />
      <TableColumn fx:id="colMatricule" prefWidth="150.0" text="MATRICULE" />
      <TableColumn fx:id="colTelephone" prefWidth="120.0" text="TÉLÉPHONE" />
      <TableColumn fx:id="colFranchiseId" prefWidth="130.0" text="NOM FRANCHISE" />
      <TableColumn fx:id="colModifier" prefWidth="60.0" text="MODIFIER" />
      <TableColumn fx:id="colSupprimer" prefWidth="60.0" text="SUPPRIMER" />
    </columns>
    <columnResizePolicy>
      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
    </columnResizePolicy>
  </TableView>

  <HBox alignment="CENTER_LEFT">
    <!-- Box stylisée pour le total -->
    <HBox alignment="CENTER" spacing="15.0"
      style="-fx-background-color: #0C0F1A; -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.05); -fx-border-radius: 15; -fx-padding: 15 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0);">
      <Label text="TOTAL FOURNISSEURS" textFill="#8892A4">
        <font>
          <Font name="System Bold" size="12.0" />
        </font>
      </Label>
      <Label fx:id="lblTotal" text="0" textFill="#00E5CC">
        <font>
          <Font name="System Bold" size="24.0" />
        </font>
      </Label>
    </HBox>
  </HBox>
</VBox>
