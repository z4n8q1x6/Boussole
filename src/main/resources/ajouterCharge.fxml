<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="600.0" spacing="20.0"
      style="-fx-background-color: #06080F;"
      stylesheets="@styles/dash.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.chargesdepenses.gui.addChargeController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button fx:id="btnListe" onAction="#handleAfficherListe" text="← Retour"
                style="-fx-background-color: transparent; -fx-text-fill: #8892A4; -fx-font-size: 14px; -fx-cursor: hand;" />
        <VBox HBox.hgrow="ALWAYS" />
        <Button fx:id="btnVersFournisseur" onAction="#handleVersFournisseur" text="Ajouter Fournisseur →"
                style="-fx-background-color: #1E293B; -fx-text-fill: #00E5CC; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;" />
    </HBox>

    <HBox spacing="15.0" alignment="CENTER_LEFT">
        <ImageView fitHeight="50.0" fitWidth="50.0" preserveRatio="true">
            <image>
                <Image url="@images/boussole_logo_n.png" />
            </image>
        </ImageView>
        <VBox>
            <Label text="Ajouter une Charge" textFill="#E8EDF5">
                <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <Label text="Remplissez les informations ci-dessous pour enregistrer une nouvelle dépense." textFill="#8892A4" wrapText="true">
                <font><Font size="13.0" /></font>
            </Label>
        </VBox>
    </HBox>

    <VBox spacing="15.0" style="-fx-background-color: #0C0F1A; -fx-background-radius: 15; -fx-padding: 25;">
        <VBox spacing="8.0">
            <Label text="Titre de la charge" textFill="#CBD5F5" />
            <TextField fx:id="titreInput" promptText="Ex: Facture Électricité"
                       style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;" />
        </VBox>

        <HBox spacing="15.0">
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label text="Montant (DT)" textFill="#CBD5F5" />
                <TextField fx:id="montantInput" promptText="0.00"
                           style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;" />
            </VBox>
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label text="Date" textFill="#CBD5F5" />
                <DatePicker fx:id="dateInput" maxWidth="1.7976931348623157E308"
                            style="-fx-background-color: #1E293B; -fx-control-inner-background: #1E293B; -fx-text-fill: white;" />
            </VBox>
        </HBox>

        <HBox spacing="15.0">
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label text="Type" textFill="#CBD5F5" />
                <ComboBox fx:id="typeCombo" maxWidth="1.7976931348623157E308"
                          style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-background-radius: 8;" />
            </VBox>
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label text="Statut" textFill="#CBD5F5" />
                <ComboBox fx:id="statusCombo" maxWidth="1.7976931348623157E308"
                          style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-background-radius: 8;" />
            </VBox>
        </HBox>

        <VBox spacing="8.0">
            <Label text="Preuve (Image)" textFill="#CBD5F5" />
            <TextField fx:id="preuveImageInput" promptText="Ex: facture.png"
                       style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;" />
        </VBox>

        <VBox spacing="8.0">
            <Label text="Franchise (ID)" textFill="#CBD5F5" />
            <TextField fx:id="franchiseIdInput" promptText="Ex: 1"
                       style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;" />
        </VBox>

        <Button fx:id="btnValider" maxWidth="1.7976931348623157E308" onAction="#handleAjouter" text="✓ Enregistrer"
                style="-fx-background-color: #0EA5E9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12; -fx-cursor: hand; -fx-font-size: 14px;">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>
    </VBox>
</VBox>
