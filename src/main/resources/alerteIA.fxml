<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="18"
  style="-fx-background-color: #06080F;"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="tn.esprit.boussole.gui.AlerteIAController"
  stylesheets="/dark-table.css">

  <padding>
    <Insets top="25" right="25" bottom="5" left="25" />
  </padding>

  <!-- Header -->
  <HBox alignment="CENTER_RIGHT">
    <Button onAction="#generate"
      text="+ Alerte"
      prefHeight="40"
      prefWidth="140"
      style="-fx-background-color: #00E5CC;
         -fx-text-fill: #06080F;
         -fx-font-weight: bold;
         -fx-background-radius: 8;
         -fx-padding: 0 18;
         -fx-cursor: hand;
         -fx-alignment: center;" />
  </HBox>

  <!-- Main content -->
  <SplitPane dividerPositions="0.6"
    style="-fx-background-color: transparent; -fx-padding: 0; -fx-border-color: transparent;"
    VBox.vgrow="ALWAYS">

    <items>

      <!-- Table card -->
      <VBox spacing="10"
        style="-fx-background-color: #0C0F1A;
               -fx-background-radius: 12;
               -fx-border-color: rgba(255,255,255,0.06);
               -fx-border-radius: 12;
               -fx-padding: 15;">
        <TableView fx:id="table"
          VBox.vgrow="ALWAYS"
          style="-fx-background-color: transparent;
                 -fx-control-inner-background: #0C0F1A;
                 -fx-table-cell-border-color: rgba(255,255,255,0.05);
                 -fx-selection-bar: #00E5CC33;
                 -fx-selection-bar-non-focused: #00E5CC22;">
          <columns>
            <TableColumn fx:id="colType" text="Nature" />
            <TableColumn fx:id="colScore" text="Gravité" />
            <TableColumn fx:id="colDate" text="Date" />
          </columns>
          <columnResizePolicy>
            <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
          </columnResizePolicy>
        </TableView>
      </VBox>

      <!-- Detail card -->
      <VBox spacing="15"
        style="-fx-background-color: #0C0F1A;
               -fx-background-radius: 12;
               -fx-border-color: rgba(255,255,255,0.06);
               -fx-border-radius: 12;
               -fx-padding: 20;">

        <Label text="Détails de l'Analyse" textFill="#E8EDF5">
          <font>
            <Font name="System Bold" size="16" />
          </font>
        </Label>

        <Label text="Rapport d'incident (IA) :"
          textFill="#8892A4"
          style="-fx-font-weight: bold;" />

        <TextArea fx:id="messageArea"
          editable="false"
          promptText="Sélectionnez une alerte pour voir les détails..."
          wrapText="true"
          VBox.vgrow="ALWAYS"
          style="-fx-background-color: #0C0F1A;
                 -fx-text-fill: #E8EDF5;
                 -fx-border-color: rgba(255,255,255,0.1);
                 -fx-border-radius: 8;
                 -fx-background-radius: 8;
                 -fx-padding: 10;" />

        <Button onAction="#delete"
          maxWidth="1.7976931348623157E308"
          text="Supprimer"
          style="-fx-background-color: #3D1A1A;
                 -fx-text-fill: #F43F5E;
                 -fx-font-weight: bold;
                 -fx-padding: 12 20;
                 -fx-background-radius: 8;
                 -fx-cursor: hand;
                 -fx-border-color: rgba(244,63,94,0.3);
                 -fx-border-radius: 8;" />
      </VBox>

    </items>
  </SplitPane>

</VBox>
