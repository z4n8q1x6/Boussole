<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.boussole.gui.DashboardFranchiseController"
            fx:id="contentPane"
            prefWidth="1100" prefHeight="750"
            stylesheets="@styles.css"
            style="-fx-background-color: #0A0E1A;">

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false"
                    style="-fx-background-color: #0A0E1A; -fx-background: #0A0E1A;
                           -fx-border-color: transparent; -fx-padding: 0;">
            <content>
                <VBox spacing="24" style="-fx-background-color: #0A0E1A;">
                    <padding><Insets top="35" right="45" bottom="35" left="45"/></padding>

                    <!-- ═══════════════════════ KPI CARDS ═══════════════════════ -->
                    <HBox spacing="18">

                        <!-- Solde Disponible -->
                        <VBox styleClass="dash-card" HBox.hgrow="ALWAYS" spacing="12">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="SOLDE DISPONIBLE" styleClass="card-label"/>
                                <Pane HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="cbDevise" prefWidth="88" prefHeight="30"
                                  style="-fx-background-color: #1C2537; -fx-text-fill: white;
                                         -fx-border-color: rgba(255,255,255,0.12);
                                         -fx-border-radius: 8; -fx-background-radius: 8;"/>
                                <Region style="-fx-background-color: #00E5CC; -fx-min-width: 4;
                                               -fx-min-height: 42; -fx-background-radius: 2;"/>
                            </HBox>
                            <Label fx:id="lblSolde" text="0,00 TND"
                                   style="-fx-font-size: 34px; -fx-font-weight: 900; -fx-text-fill: #22C55E;"/>
                            <Label fx:id="lblContreValeur" text="(soit ≈ 0.00 €)"
                                   style="-fx-text-fill: #64748B; -fx-font-size: 13px; -fx-font-style: italic;"/>
                        </VBox>

                        <!-- Limite Dépenses -->
                        <VBox styleClass="dash-card" HBox.hgrow="ALWAYS" spacing="12">
                            <Label text="LIMITE DÉPENSES" styleClass="card-label"/>
                            <Label fx:id="lblLimiteDepenses" text="— TND"
                                   style="-fx-font-size: 34px; -fx-font-weight: 900; -fx-text-fill: #FFA726;"/>
                        </VBox>

                        <!-- Objectif Revenu -->
                        <VBox styleClass="dash-card" HBox.hgrow="ALWAYS" spacing="12">
                            <Label text="OBJECTIF REVENU" styleClass="card-label"/>
                            <Label fx:id="lblObjectifRevenu" text="— TND"
                                   style="-fx-font-size: 34px; -fx-font-weight: 900; -fx-text-fill: #E2E8F0;"/>
                        </VBox>
                    </HBox>

                    <!-- ═══════════════════════ FORMULAIRE + TABLEAU ═══════════════════════ -->
                    <HBox spacing="22">

                        <!-- Formulaire Nouvelle Transaction -->
                        <VBox styleClass="dash-card" prefWidth="340" spacing="18">
                            <Label text="Nouvelle Transaction"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                            <VBox spacing="7">
                                <Label text="Date" styleClass="card-label"/>
                                <DatePicker fx:id="dpDate" maxWidth="Infinity" prefHeight="40"
                                            style="-fx-background-color: #1C2537;
                                                   -fx-border-color: rgba(255,255,255,0.10);
                                                   -fx-border-radius: 10; -fx-background-radius: 10;"/>
                            </VBox>

                            <VBox spacing="7">
                                <Label text="Montant (TND)" styleClass="card-label"/>
                                <TextField fx:id="tfMontant" promptText="0.00" prefHeight="40"
                                           style="-fx-background-color: #1C2537; -fx-text-fill: white;
                                                  -fx-prompt-text-fill: #4A5568;
                                                  -fx-border-color: rgba(255,255,255,0.10);
                                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                                  -fx-padding: 10 14 10 14;"/>
                            </VBox>

                            <VBox spacing="7">
                                <Label text="Description" styleClass="card-label"/>
                                <TextField fx:id="tfDescription" promptText="Ex: Vente du jour" prefHeight="40"
                                           style="-fx-background-color: #1C2537; -fx-text-fill: white;
                                                  -fx-prompt-text-fill: #4A5568;
                                                  -fx-border-color: rgba(255,255,255,0.10);
                                                  -fx-border-radius: 10; -background-radius: 10;
                                                  -fx-padding: 10 14 10 14;"/>
                            </VBox>

                            <Pane prefHeight="20"/>

                            <Button fx:id="btnValider" text="VALIDER RECETTE"
                                    maxWidth="Infinity" prefHeight="50"
                                    onAction="#validerRecette"
                                    style="-fx-background-color: linear-gradient(to right, #00E5CC, #00B4D8);
                                           -fx-text-fill: #0F172A; -fx-font-weight: 900; -fx-font-size: 14px;
                                           -fx-background-radius: 12; -fx-cursor: hand;
                                           -fx-effect: dropshadow(gaussian,rgba(0,229,204,0.4),15,0,0,4);"/>
                        </VBox>

                        <!-- Tableau Derniers Mouvements -->
                        <VBox styleClass="dash-card" HBox.hgrow="ALWAYS" spacing="14" prefHeight="420">
                            <Label text="Derniers Mouvements"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TableView fx:id="tableMovements" VBox.vgrow="ALWAYS"
                                       style="-fx-background-color: transparent; -fx-border-color: transparent;">
                                <columns>
                                    <TableColumn fx:id="colDate"        text="DATE"        prefWidth="140"/>
                                    <TableColumn fx:id="colType"        text="TYPE"        prefWidth="120"/>
                                    <TableColumn fx:id="colDescription" text="DESCRIPTION" prefWidth="160"/>
                                    <TableColumn fx:id="colMontant"     text="MONTANT"     prefWidth="120"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
