<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.chargesdepenses.gui.afficherFrontChargeController">
   <children>
      <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="Nos Charges &amp; Dépenses" textFill="#0e5384">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Label>

            <!-- Barre de Recherche et Tri -->
            <HBox alignment="CENTER" spacing="15.0" maxWidth="600.0">
               <TextField fx:id="txtRecherche" promptText="Rechercher par titre..." prefWidth="250.0" style="-fx-background-radius: 20; -fx-padding: 8 15 8 15; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 0);" />
               <ComboBox fx:id="comboTri" promptText="Trier par" prefWidth="180.0" style="-fx-background-radius: 20; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 0);" />
            </HBox>

            <!-- Zone de contenu défilante -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox alignment="CENTER">
                     <children>
                        <GridPane fx:id="gridCharges" alignment="CENTER" hgap="30.0" vgap="30.0">
                          <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                          </rowConstraints>
                        </GridPane>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>

            <!-- Contrôles de Pagination -->
            <HBox alignment="CENTER" maxWidth="400.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>
               <children>
                  <Button fx:id="btnPrecedent" mnemonicParsing="false" style="-fx-background-color: #0e5384; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="&lt; Précédent">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
                  <Label fx:id="lblPageInfo" text="Page 1 / 1" textFill="#555555">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Button fx:id="btnSuivant" mnemonicParsing="false" style="-fx-background-color: #0e5384; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="Suivant &gt;">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
               </children>
            </HBox>

            <!-- Bouton Ajouter -->
            <Button fx:id="btnAjouter" text="+" style="-fx-background-color: #4593cb; -fx-text-fill: white; -fx-font-size: 24; -fx-background-radius: 25; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);" maxWidth="50.0" maxHeight="50.0" minWidth="50.0" minHeight="50.0" />
         </children>
      </VBox>
   </children>
</AnchorPane>
